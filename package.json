{
  "name": "dws6-auth-backend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "DWS IQ Auth Backend (Express + TypeScript)",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "blog:tracked": "node scripts/blog/check-tracked-sources.mjs",
    "docker:build:carbon-api": "docker build -t dws6-carbon-api:latest ./mcp-servers/supabase",
    "docker:build:supabase-official-mcp": "docker build -t dws6-supabase-official-mcp:latest ./mcp-servers/supabase-official",
    "db:migrate:042": "tsx scripts/apply-migration-042.ts",
    "db:migrate:043": "tsx scripts/apply-migration-043.ts",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:seed:projects": "tsx scripts/seed-demo-projects.ts",
    "industry": "tsx scripts/industry.ts",
    "diag:dws-api": "tsx scripts/test-dws-api.ts",
    "diag:mcp": "tsx scripts/test-mcp-http.ts",
    "diag:ollama": "tsx scripts/test-veriton-ollama.ts",
    "train:deploy": "bash scripts/deploy-acer-training.sh deploy",
    "train:status": "bash scripts/deploy-acer-training.sh status",
    "train:smoke": "python3 -m pytest infrastructure/llm-training/tests -v",
    "diag:ses": "node --import tsx scripts/test-ses-smtp.ts",
    "learn:archive-index": "node scripts/build-learn-archive-index.mjs",
    "learn:check-links": "node scripts/check-learn-links.mjs",
    "learn:fix-links": "node scripts/fix-learn-links.mjs",
    "ontology:index": "node scripts/ontology-admin-index.mjs build",
    "ontology:lookup": "node scripts/ontology-admin-index.mjs lookup",
    "aegis:pilot": "node --import tsx scripts/aegis-pilot.ts",
    "aegis:pilot:rehearse-isolated": "bash scripts/aegis-pilot-isolated-rehearsal.sh",
    "morning:briefing": "node --import tsx scripts/send-morning-brief-v2.ts",
    "morning:briefing:force": "node --import tsx scripts/send-morning-brief-v2.ts --force",
    "ted:fetch": "node --import tsx scripts/ted-fetch.ts",
    "ted:outreach": "node --import tsx scripts/ted-outreach-send.ts",
    "ted:followup": "node --import tsx scripts/ted-followup.ts",
    "ted:learning": "node --import tsx scripts/ted-learning-weekly.ts",
    "ted:daily": "node --import tsx scripts/ted-daily-pipeline.ts",
    "ted:sales-queue": "node --import tsx scripts/sales-outreach-ted-queue.ts",
    "funding:rss": "node --import tsx scripts/eu-funding-rss.ts",
    "revolut:generate-links": "node --import tsx scripts/generate-revolut-links.ts",
    "diag:supabase-rest": "tsx scripts/test-supabase-rest.ts",
    "preflight:product-orders": "tsx scripts/preflight-product-orders.ts",
    "vault:push": "tsx scripts/provision-secrets-aiven.ts",
    "vault:push:dry": "tsx scripts/provision-secrets-aiven.ts --dry-run",
    "db:push": "bash scripts/db_push.sh",
    "db:push:skip-link": "bash scripts/db_push.sh --skip-link",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.json",
    "build:whitepapers": "python3 scripts/build-whitepapers.py",
    "sync:landing-pages": "node scripts/sync-landing-pages.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "skills:check": "node scripts/skill-manifest-sync.mjs --check && node --experimental-strip-types skills/skill-cleaner/scripts/skill-cleaner.ts --root skills --root .claude/commands --exit-code",
    "skills:verify-surfaces": "tsx scripts/verify-skill-surfaces.ts",
    "skills:sync-guide": "node scripts/skill-manifest-sync.mjs --write-guide",
    "skills:sync-antigravity": "node scripts/skill-manifest-sync.mjs --antigravity",
    "dora:metrics": "tsx scripts/dora-metrics.ts",
    "analyze:decision-log": "tsx scripts/analyze-decision-log.ts",
    "lint:migrations": "node scripts/check-migration-filenames.mjs --changed --base origin/main",
    "env:pins": "node scripts/check-dev-env-pins.mjs",
    "env:pins:strict": "node scripts/check-dev-env-pins.mjs --require-aligned",
    "validate:pricing": "tsx scripts/validate-pricing.ts && node scripts/validate-product-publication.mjs",
    "validate:dod": "bash scripts/validate-dod.sh",
    "fairness:pilot": "tsx scripts/run-fairness-pilot.ts",
    "factory:route": "tsx scripts/factory-route.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:test:rls": "tsx scripts/test-rls-agent-nudges.ts",
    "temporal:worker": "node --import tsx scripts/temporal-worker.ts",
    "temporal:schedules:setup": "node --import tsx scripts/temporal-schedules-setup.ts",
    "temporal:dev-server": "bash scripts/temporal-dev-server.sh",
    "temporal:approve": "node --import tsx scripts/temporal-send-approval.ts",
    "temporal:agent-question": "node --import tsx scripts/temporal-answer-agent-question.ts",
    "opencode:check": "node .claude/hooks/opencode-check.js",
    "opencode:status": "git -C opencode-all status --short 2>/dev/null || echo 'OpenCode not found'",
    "opencode:update": "bash scripts/update-opencode-all.sh",
    "diag:nemoclaw": "node scripts/verify-nemoclaw-runtime.mjs",
    "build:learning-hub": "node scripts/build-learning-hub.mjs",
    "validate:learning-hub": "node scripts/build-learning-hub.mjs --validate",
    "check:live-versions": "node scripts/check-live-versions.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@supabase/supabase-js": "^2.39.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@upstash/redis": "^1.36.2",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "isomorphic-dompurify": "^3.10.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.20.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "undici": "7.30.0",
    "qs": ">=6.16.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.258",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.95.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  }
}
