{
  "name": "dws6-auth-backend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "DWS IQ Auth Backend (Express + TypeScript)",
  "scripts": {
    "docker:build:carbon-api": "docker build -t dws6-carbon-api:latest ./mcp-servers/supabase",
    "docker:build:supabase-official-mcp": "docker build -t dws6-supabase-official-mcp:latest ./mcp-servers/supabase-official",
    "db:migrate:042": "tsx scripts/apply-migration-042.ts",
    "db:migrate:043": "tsx scripts/apply-migration-043.ts",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:seed:projects": "tsx scripts/seed-demo-projects.ts",
    "diag:dws-api": "tsx scripts/test-dws-api.ts",
    "diag:mcp": "tsx scripts/test-mcp-http.ts",
    "diag:ollama": "tsx scripts/test-veriton-ollama.ts",
    "diag:ses": "node --import tsx scripts/test-ses-smtp.ts",
    "morning:briefing": "node --import tsx scripts/send-morning-briefing.ts",
    "morning:briefing:force": "node --import tsx scripts/send-morning-briefing.ts --force",
    "ted:fetch": "node --import tsx scripts/ted-fetch.ts",
    "ted:outreach": "node --import tsx scripts/ted-outreach-send.ts",
    "ted:followup": "node --import tsx scripts/ted-followup.ts",
    "ted:learning": "node --import tsx scripts/ted-learning-weekly.ts",
    "ted:daily": "node --import tsx scripts/ted-daily-pipeline.ts",
    "revolut:generate-links": "node --import tsx scripts/generate-revolut-links.ts",
    "diag:supabase-rest": "tsx scripts/test-supabase-rest.ts",
    "db:push": "bash scripts/db_push.sh",
    "db:push:skip-link": "bash scripts/db_push.sh --skip-link",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.json",
    "sync:landing-pages": "node scripts/sync-landing-pages.js",
    "lint": "echo \"No linter configured\"",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.36.2",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^4.0.16",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
