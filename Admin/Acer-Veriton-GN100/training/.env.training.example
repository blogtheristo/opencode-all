# GN100 training container environment — copy to .env.training and fill in.
# .env.training is git-ignored / never committed (contains a HF token).

# Hugging Face token for gated model downloads (Llama 3.1/3.3). Required.
HF_TOKEN=

# Optional experiment tracking. Leave blank to disable.
WANDB_API_KEY=

# MLflow tracking URI (defaults to local file store inside the container).
MLFLOW_TRACKING_URI=
