# Veriton edge integration variables
# Copy values into the client deployment environment or .env.local as appropriate.

# DWS control plane
DWS_API_URL=https://your-dws-backend.example.com
MCP_HUB_URL=https://your-mcp-hub.example.com

# Supabase app-layer access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me

# Veriton inference and sandbox endpoints
OLLAMA_HOST=http://localhost:11435
OPENSANDBOX_HOST=http://192.168.1.50:8080
OPENSANDBOX_API_KEY=replace-me-if-enabled

# Backend-side sandbox selection
SANDBOX_STAGE=opensandbox

# Optional admin-only direct database access
DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres
