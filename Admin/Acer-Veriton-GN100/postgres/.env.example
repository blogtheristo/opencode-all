# DWS Edge PostgreSQL — Environment Variables
# Copy to .env and fill in values before deploying.
#
# SECURITY: Never commit .env to git. Only .env.example is tracked.

# PostgreSQL credentials (REQUIRED)
EDGE_PG_PASSWORD=change_me_to_a_strong_password

# pgAdmin (optional — only used with 'admin' profile)
PGADMIN_EMAIL=risto@onelifetime.world
PGADMIN_PASSWORD=change_me
