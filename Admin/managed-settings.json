{
  "disableBypassPermissionsMode": "disable",
  "allowManagedPermissionRulesOnly": false,
  "permissions": {
    "deny": [
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.secret)",
      "Read(./credentials.json)",
      "Read(./service-account-*.json)"
    ]
  }
}
