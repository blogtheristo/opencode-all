{
  "mcpServers": {
    "dws-supabase": {
      "command": "docker",
      "args": [
        "exec",
        "dws-mcp-supabase",
        "python",
        "/app/server.py"
      ],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}"
      }
    },
    "dws-hub": {
      "command": "docker",
      "args": [
        "exec",
        "dws-mcp-hub",
        "python",
        "-c",
        "import sys; sys.path.append('/app'); from server import app; import uvicorn; uvicorn.run(app, host='0.0.0.0', port=8765)"
      ],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}"
      }
    }
  }
}
