#!/usr/bin/env bash
# bin/dream-on — spawn a fresh Claude Code session for each Firehorse Dreaming run.
#
# Why: typing /dream-on inside an existing session reuses that session's
# context window and transcript. Across many runs this both bloats context
# and tangles dream cycles with whatever else the session was doing. Each
# dream cycle should be its own session: fresh context, one .jsonl
# transcript per cycle, one PR per cycle.
#
# Usage:
#   dream-on                  # pick newest unpromoted proposal (or next queue item)
#   dream-on --next           # explicit alias
#   dream-on <proposal-path>  # target a specific proposal
#   dream-on <topic-keyword>  # filter proposals whose body mentions <topic>
#
# Behavior: this is just `exec claude "/dream-on $*"` — a one-line wrapper.
# Plan-mode HIL approval works (claude is invoked interactively).
# When the spawned session finishes its work and exits, you're back in
# your shell with one new transcript at ~/.claude/projects/-home-user-dws6/
# and (typically) one new commit + PR update on the current branch.
#
# To make this command available globally:
#   echo 'export PATH="'"$(git rev-parse --show-toplevel)"'/bin:$PATH"' >> ~/.zshrc   # or ~/.bashrc
#   exec $SHELL -l
#
# See skills/dream-on/SKILL.md for the full loop and SKILL.md § "Invocation"
# for why this wrapper is the canonical entry point (not `/dream-on` typed
# into an existing session).

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "dream-on: \`claude\` CLI not found in PATH." >&2
  echo "Install Claude Code or add /opt/node22/bin to PATH and retry." >&2
  exit 127
fi

exec claude "/dream-on $*"
