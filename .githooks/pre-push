#!/usr/bin/env sh
# DWS6 NO-DELETE POLICY + BRANCH NAME VALIDATION
# Blocks destructive pushes (branch deletions) from local machines.
# Also validates branch names to prevent corruption issues.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# This hook prevents:
#   git push origin --delete <branch>
#   git push origin :<branch>
#   Branch names with invalid characters: ( ) [ ] { } < > # * ? : | " \

remote_name="$1"
remote_url="$2"

# First, validate current branch name
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Check for invalid characters that can cause git corruption
# These characters can cause filesystem issues or git corruption
if echo "$current_branch" | grep -q '[()[\]{}<>#*?:|"\\]'; then
    echo "ERROR: Branch name '$current_branch' contains invalid characters!" 1>&2
    echo "Branch names should not contain: ( ) [ ] { } < > # * ? : | \" \\" 1>&2
    echo "Please rename your branch with: git branch -m <new-clean-name>" 1>&2
    echo "Example: feature/my-feature-name" 1>&2
    exit 1
fi

# Check for spaces
if echo "$current_branch" | grep -q ' '; then
    echo "ERROR: Branch name '$current_branch' contains spaces!" 1>&2
    echo "Please rename your branch with: git branch -m <new-clean-name>" 1>&2
    echo "Use hyphens instead of spaces: feature/my-feature-name" 1>&2
    exit 1
fi

# Read lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
# A deletion push has local_sha == 000.. and local_ref == (delete) or empty.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000)
      echo "ERROR: NO-DELETE POLICY: refusing to delete remote ref '$remote_ref' on '$remote_name' ($remote_url)" 1>&2
      echo "If you truly need to retire a branch, mark it as archived (e.g., prefix 'archive/') instead of deleting." 1>&2
      exit 1
      ;;
  esac
done

# ZenFree local scanner removed: false positives blocked routine work.
# Security checks run GitHub-side instead.

# ─── Local CI runner + audit log ──────────────────────────────────────────────
# Replaces GitHub Actions checks: test.yml, secret-scan-gitleaks.yml, ruff.yml,
# and the npm-audit portion of dependency_review.yml. Each run produces an
# immutable audit record in .ci-audit/runs/ (hash-chained) and is POSTed to
# Supabase ci_audit_log when env vars are set. See docs/CI_AUDIT.md.
#
# INCIDENT HARDENING (2026-08-25 bare-flip): this block is FAIL-CLOSED.
# If the worktree root cannot be resolved or local-ci.sh is missing, the push
# is BLOCKED — a silent CI skip here once let an unguarded push through.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ $? -ne 0 ] || [ -z "$REPO_ROOT" ]; then
  echo "" >&2
  echo "ERROR: cannot resolve worktree root (git rev-parse --show-toplevel failed)." >&2
  echo "       Refusing to push without local CI — fail-closed (2026-08-25 incident control)." >&2
  echo "       Fix: verify core.bare=false and per-worktree config.worktree overrides." >&2
  exit 1
fi
LOCAL_CI="$REPO_ROOT/scripts/local-ci.sh"
if [ ! -x "$LOCAL_CI" ]; then
  echo "" >&2
  echo "ERROR: local-ci.sh not found or not executable at: $LOCAL_CI" >&2
  echo "       Refusing to push without local CI — fail-closed (2026-08-25 incident control)." >&2
  exit 1
fi
if [ "${SKIP_LOCAL_CI:-}" = "1" ]; then
  echo "WARNING: SKIP_LOCAL_CI=1 — explicit loud bypass of local CI for this push." >&2
  exit 0
fi
echo ""
echo "🧪 Running local CI (vitest + gitleaks + npm audit + ruff)..."
if ! CI_TRIGGER_KIND=pre-push bash "$LOCAL_CI"; then
  echo ""
  echo "ERROR: local CI failed — see .ci-audit/runs/ for the failure record." >&2
  echo "  • Fix the failures and retry (a new audit record will be appended and become the latest record for this branch/commit)." >&2
  echo "  • Bypass (still audited via git reflog): git push --no-verify" >&2
  echo "  • Skip only the CI: SKIP_LOCAL_CI=1 git push" >&2
  exit 1
fi

exit 0

