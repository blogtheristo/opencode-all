#!/usr/bin/env sh
# DWS6 NO-DELETE POLICY + BRANCH NAME VALIDATION
# Blocks destructive pushes (branch deletions) from local machines.
# Also validates branch names to prevent corruption issues.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# This hook prevents:
#   git push origin --delete <branch>
#   git push origin :<branch>
#   Branch names with invalid characters: ( ) [ ] { } < > # * ? : | " \

remote_name="$1"
remote_url="$2"

# First, validate current branch name
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Check for invalid characters that can cause git corruption
# These characters can cause filesystem issues or git corruption
if echo "$current_branch" | grep -q '[()[\]{}<>#*?:|"\\]'; then
    echo "ERROR: Branch name '$current_branch' contains invalid characters!" 1>&2
    echo "Branch names should not contain: ( ) [ ] { } < > # * ? : | \" \\" 1>&2
    echo "Please rename your branch with: git branch -m <new-clean-name>" 1>&2
    echo "Example: feature/my-feature-name" 1>&2
    exit 1
fi

# Check for spaces
if echo "$current_branch" | grep -q ' '; then
    echo "ERROR: Branch name '$current_branch' contains spaces!" 1>&2
    echo "Please rename your branch with: git branch -m <new-clean-name>" 1>&2
    echo "Use hyphens instead of spaces: feature/my-feature-name" 1>&2
    exit 1
fi

# Read lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
# A deletion push has local_sha == 000.. and local_ref == (delete) or empty.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000)
      echo "ERROR: NO-DELETE POLICY: refusing to delete remote ref '$remote_ref' on '$remote_name' ($remote_url)" 1>&2
      echo "If you truly need to retire a branch, mark it as archived (e.g., prefix 'archive/') instead of deleting." 1>&2
      exit 1
      ;;
  esac
done

# ZenFree security scan — block push on critical/high findings
# Runs locally to avoid GitHub Actions costs
SCANNER="$(git rev-parse --show-toplevel)/scripts/scan_critical_bugs.py"
if [ -f "$SCANNER" ] && command -v python3 >/dev/null 2>&1; then
  echo "🔒 Running ZenFree security scan..."
  output=$(python3 "$SCANNER" 2>&1)
  scanner_status=$?
  if [ "$scanner_status" -ne 0 ]; then
    echo "$output"
    echo ""
    echo "ERROR: ZenFree scanner failed with exit code $scanner_status." 1>&2
    echo "Fix the scanner error or bypass with: git push --no-verify" 1>&2
    exit 1
  fi
  critical=$(echo "$output" | grep -oP 'Critical: \K[0-9]+' || echo "0")
  high=$(echo "$output" | grep -oP 'High: \K[0-9]+' || echo "0")
  if [ "$critical" -gt 0 ] || [ "$high" -gt 0 ]; then
    echo "$output"
    echo ""
    echo "ERROR: ZenFree found $critical critical and $high high severity issues." 1>&2
    echo "Fix them before pushing, or bypass with: git push --no-verify" 1>&2
    exit 1
  fi
  echo "✅ ZenFree: no critical/high issues found"
elif [ -f "$SCANNER" ] && command -v python >/dev/null 2>&1; then
  echo "🔒 Running ZenFree security scan..."
  output=$(python "$SCANNER" 2>&1)
  scanner_status=$?
  if [ "$scanner_status" -ne 0 ]; then
    echo "$output"
    echo ""
    echo "ERROR: ZenFree scanner failed with exit code $scanner_status." 1>&2
    echo "Fix the scanner error or bypass with: git push --no-verify" 1>&2
    exit 1
  fi
  critical=$(echo "$output" | grep -oP 'Critical: \K[0-9]+' || echo "0")
  high=$(echo "$output" | grep -oP 'High: \K[0-9]+' || echo "0")
  if [ "$critical" -gt 0 ] || [ "$high" -gt 0 ]; then
    echo "$output"
    echo ""
    echo "ERROR: ZenFree found $critical critical and $high high severity issues." 1>&2
    echo "Fix them before pushing, or bypass with: git push --no-verify" 1>&2
    exit 1
  fi
  echo "✅ ZenFree: no critical/high issues found"
fi

# ─── Local CI runner + audit log ──────────────────────────────────────────────
# Replaces GitHub Actions checks: test.yml, secret-scan-gitleaks.yml, ruff.yml,
# and the npm-audit portion of dependency_review.yml. Each run produces an
# immutable audit record in .ci-audit/runs/ (hash-chained) and is POSTed to
# Supabase ci_audit_log when env vars are set. See docs/CI_AUDIT.md.
LOCAL_CI="$(git rev-parse --show-toplevel)/scripts/local-ci.sh"
if [ -x "$LOCAL_CI" ] && [ "${SKIP_LOCAL_CI:-}" != "1" ]; then
  echo ""
  echo "🧪 Running local CI (vitest + gitleaks + npm audit + ruff)..."
  if ! CI_TRIGGER_KIND=pre-push bash "$LOCAL_CI"; then
    echo ""
    echo "ERROR: local CI failed — see .ci-audit/runs/ for the failure record." 1>&2
    echo "  • Fix the failures and retry (a new audit record will be appended and become the latest record for this branch/commit)." 1>&2
    echo "  • Bypass (still audited via git reflog): git push --no-verify" 1>&2
    echo "  • Skip only the CI (keep ZenFree): SKIP_LOCAL_CI=1 git push" 1>&2
    exit 1
  fi
fi

exit 0

