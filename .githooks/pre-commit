#!/usr/bin/env sh
# DWS6 pre-commit security gate
# Safer policy: block by secret patterns/content, not folders.

set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/gdpr-safety-check.ps1"
  exit $?
fi

if command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "scripts/gdpr-safety-check.ps1"
  exit $?
fi

echo "[WARN] PowerShell not found; running minimal fallback checks..."

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

blocked=0
for f in $staged; do
  case "$f" in
    .env|.env.*)
      case "$f" in
        .env.example|.env.*.example) ;;
        *)
          echo "BLOCKED: $f [.env secret file]"
          blocked=1
          ;;
      esac
      ;;
    *.pem|*.key|*credentials.json|*service-account-*.json)
      echo "BLOCKED: $f [secret file pattern]"
      blocked=1
      ;;
    Admin/Claudecode_Secrets/*)
      case "$f" in
        Admin/Claudecode_Secrets/README.md|Admin/Claudecode_Secrets/*.example) ;;
        *)
          echo "BLOCKED: $f [reserved sensitive folder]"
          blocked=1
          ;;
      esac
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  echo "Commit blocked by pre-commit security checks."
  exit 1
fi

# ============ TypeScript & Lint Checks (staged .ts/.tsx files only) ============

ts_files=""
for f in $staged; do
  case "$f" in
    *.ts|*.tsx) ts_files="$ts_files $f" ;;
  esac
done

if [ -n "$ts_files" ]; then
  # TypeScript type check (if tsc is available)
  if command -v npx >/dev/null 2>&1 && [ -f "tsconfig.json" ]; then
    echo "[pre-commit] Running TypeScript check on staged files..."
    if ! npx tsc --noEmit --pretty 2>/dev/null; then
      echo ""
      echo "[WARN] TypeScript errors found — commit proceeds (advisory)."
      echo "       Run 'npm run build' to see full errors."
    fi
  fi

  # ESLint check (if eslint config exists)
  if command -v npx >/dev/null 2>&1 && [ -f "eslint.config.js" ] || [ -f ".eslintrc.json" ] || [ -f ".eslintrc.js" ]; then
    echo "[pre-commit] Running ESLint on staged .ts/.tsx files..."
    # shellcheck disable=SC2086
    if ! npx eslint --max-warnings 0 $ts_files 2>/dev/null; then
      echo ""
      echo "[WARN] ESLint warnings/errors found — commit proceeds (advisory)."
      echo "       Run 'npm run lint' to fix."
    fi
  fi
fi

exit 0
