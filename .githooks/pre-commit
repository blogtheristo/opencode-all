#!/usr/bin/env sh
# DWS6 pre-commit security gate
# Safer policy: block by secret patterns/content, not folders.

set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/gdpr-safety-check.ps1"
  exit $?
fi

if command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "scripts/gdpr-safety-check.ps1"
  exit $?
fi

echo "[WARN] PowerShell not found; running minimal fallback checks..."

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

blocked=0
for f in $staged; do
  case "$f" in
    .env|.env.*)
      case "$f" in
        .env.example|.env.*.example) ;;
        *)
          echo "BLOCKED: $f [.env secret file]"
          blocked=1
          ;;
      esac
      ;;
    *.pem|*.key|*credentials.json|*service-account-*.json)
      echo "BLOCKED: $f [secret file pattern]"
      blocked=1
      ;;
    Admin/Claudecode_Secrets/*)
      case "$f" in
        Admin/Claudecode_Secrets/README.md|Admin/Claudecode_Secrets/*.example) ;;
        *)
          echo "BLOCKED: $f [reserved sensitive folder]"
          blocked=1
          ;;
      esac
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  echo "Commit blocked by pre-commit security checks."
  exit 1
fi

# ============ TypeScript & Lint Checks (staged .ts/.tsx files only) ============

ts_files=""
for f in $staged; do
  case "$f" in
    *.ts|*.tsx) ts_files="$ts_files $f" ;;
  esac
done

if [ -n "$ts_files" ]; then
  # TypeScript type check (blocks commit unless SKIP_TSC=1)
  if [ "${SKIP_TSC:-0}" = "1" ]; then
    echo "[pre-commit] SKIP_TSC=1 — skipping TypeScript check."
  elif command -v npx >/dev/null 2>&1 && [ -f "tsconfig.json" ]; then
    echo "[pre-commit] Running TypeScript check..."
    if ! npx --no-install tsc --noEmit --pretty 2>&1; then
      echo ""
      echo "BLOCKED: TypeScript errors found. Fix them or bypass with: SKIP_TSC=1 git commit ..."
      exit 1
    fi
  fi

  # ESLint check (blocks commit — quality gate)
  if command -v npx >/dev/null 2>&1 && { [ -f "eslint.config.js" ] || [ -f "eslint.config.mjs" ] || [ -f ".eslintrc.json" ] || [ -f ".eslintrc.js" ]; }; then
    echo "[pre-commit] Running ESLint on staged .ts/.tsx files..."
    # shellcheck disable=SC2086
    if ! npx --no-install eslint --max-warnings 0 $ts_files 2>&1; then
      echo ""
      echo "BLOCKED: ESLint errors found. Fix them or bypass with: SKIP_LINT=1 git commit ..."
      if [ "${SKIP_LINT:-0}" = "1" ]; then
        echo "[pre-commit] SKIP_LINT=1 — bypassing ESLint block."
      else
        exit 1
      fi
    fi
  fi
fi

exit 0
