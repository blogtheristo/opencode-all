# DWS MCP Hub Environment Configuration
# Copy this file to .env.mcp and fill in your actual values
# Usage: cp env.mcp.example .env.mcp

# ============================================================================
# MCP COORDINATION HUB (Port 8765)
# ============================================================================
MCP_HUB_PORT=8765
MCP_HUB_HOST=0.0.0.0
MCP_LOG_LEVEL=info

# ============================================================================
# SUPABASE MCP SERVER (Port 8766)
# ============================================================================
SUPABASE_MCP_PORT=8766
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Database Connection (for direct PostgreSQL access)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ============================================================================
# TEMPORAL.IO WORKFLOW ENGINE
# ============================================================================
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=dws-mcp-hub
TEMPORAL_UI_PORT=8088

# ============================================================================
# AI MODEL PROVIDERS
# ============================================================================
# Cursor AI Integration
CURSOR_API_KEY=your-cursor-api-key-here

# Claude Code (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini Pro (Google)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_PROJECT_ID=your-gcp-project-id

# Groq (for fast inference)
GROQ_API_KEY=your-groq-api-key-here

# ============================================================================
# SESSION PERSISTENCE
# ============================================================================
# Session storage configuration
SESSION_STORE_TYPE=supabase  # Options: supabase, postgresql, redis
SESSION_TTL_HOURS=168  # 7 days
AUTO_GENERATE_CLAUDE_MD=true

# ============================================================================
# WORKFLOW PATTERNS
# ============================================================================
# Enable/disable workflow patterns
ENABLE_FAN_OUT_PATTERN=true
ENABLE_REFLECTION_PATTERN=true
ENABLE_SEQUENTIAL_PATTERN=true

# Parallel task limits
MAX_PARALLEL_TASKS=10
REFLECTION_MAX_ITERATIONS=3

# ============================================================================
# FIREHORSE ADD-ONS INTEGRATION
# ============================================================================
FIREHORSE_API_URL=https://api.dws10.com
FIREHORSE_API_KEY=your-firehorse-api-key-here

# ============================================================================
# COMPLIANCE & CARBON CALCULATIONS
# ============================================================================
# EU Compliance Rules
EU_COMPLIANCE_DB_ENABLED=true
EN_15978_CALCULATOR_ENABLED=true

# Carbon calculation endpoints
CARBON_CALC_API_URL=https://api.dws10.com/v1/carbon
BIM_INTEGRATION_ENABLED=true

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json  # Options: json, text
LOG_OUTPUT=stdout  # Options: stdout, file, both

# ============================================================================
# SECURITY
# ============================================================================
# API Authentication
MCP_HUB_AUTH_ENABLED=true
MCP_HUB_API_KEY=your-secure-api-key-here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://onelifetime.world,https://api.dws10.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Container restart policy
RESTART_POLICY=unless-stopped

# Network configuration
NETWORK_NAME=mcp-hub-network

# Volume configuration
POSTGRES_DATA_PATH=./data/postgres
TEMPORAL_DATA_PATH=./data/temporal
LOGS_PATH=./logs

# ============================================================================
# DEVELOPMENT / PRODUCTION
# ============================================================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG_MODE=false

# ============================================================================
# CLOUDFLARE INTEGRATION (Hybrid Deployment)
# ============================================================================
# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare Tunnel (for production)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Edge Gateway URLs
CLOUDFLARE_GATEWAY_URL=https://mcp.dws10.com
CLOUDFLARE_AGENT_URL=https://agent.dws10.com
CLOUDFLARE_SANDBOX_URL=https://sandbox.dws10.com
CLOUDFLARE_BILLING_URL=https://billing.dws10.com

# OAuth Configuration (for enterprise customers)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_TOKEN_URL=https://auth.dws10.com/oauth/token

# Stripe Integration (for sandbox billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Admin API Key (for tenant management)
ADMIN_API_KEY=your-secure-admin-api-key

# ============================================================================
# DATABASE PASSWORDS (Hybrid Deployment)
# ============================================================================
MCP_DB_PASSWORD=mcp_password_dev

# ============================================================================
# MONITORING (Optional)
# ============================================================================
GRAFANA_PASSWORD=admin

