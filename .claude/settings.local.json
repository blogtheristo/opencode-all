{
  "permissions": {
    "allow": [
      "Bash(powershell -Command:*)",
      "Bash(powershell -NoProfile -Command:*)",
      "Bash(pandoc:*)",
      "Bash(pip install:*)",
      "Bash(python -c:*)",
      "Bash(python -X utf8 -c:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(start:*)",
      "Bash(node $CLAUDE_PROJECT_DIR/scripts/gen-thesis-html.cjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pretooluse-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sql-safety-guard.sh"
          }
        ]
      }
    ]
  }
}
