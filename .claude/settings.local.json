{
  "permissions": {
    "allow": [
      "Bash(powershell -Command:*)",
      "Bash(powershell -NoProfile -Command:*)",
      "Bash(pandoc:*)",
      "Bash(pip install:*)",
      "Bash(python -c:*)",
      "Bash(python -X utf8 -c:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(start:*)",
      "Bash(node $CLAUDE_PROJECT_DIR/scripts/gen-thesis-html.cjs)",
      "Bash(node scripts/gen-thesis-html.cjs)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "Supabase MCP",
    "Upstash Redis",
    "MCP Hub"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/session-stop.sh"
          }
        ]
      }
    ]
  }
}
