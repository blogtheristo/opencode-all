{
  "permissions": {
    "allow": [
      "Bash(powershell -Command:*)",
      "Bash(powershell -NoProfile -Command:*)",
      "Bash(pandoc:*)",
      "Bash(pip install:*)",
      "Bash(python -c:*)",
      "Bash(python -X utf8 -c:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(start:*)",
      "Bash(node $CLAUDE_PROJECT_DIR/scripts/gen-thesis-html.cjs)",
      "Bash(node scripts/gen-thesis-html.cjs)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Read($CLAUDE_PROJECT_DIR/**)",
      "Bash(gh pr:*)",
      "Bash(python3 -c \"import json,sys; p=json.load\\(sys.stdin\\); [print\\(x.get\\('sku',''\\),x.get\\('title',''\\),x.get\\('status',''\\)\\) for x in p.get\\('products',[]\\)]\")",
      "Bash(python3 -c:*)",
      "Bash(export PATH=\"$PATH:/mingw64/bin:/usr/bin:/c/Program Files/Git/bin:/c/Program Files/Git/cmd\")",
      "Bash(export PATH=\"$PATH:/mingw64/bin:/usr/bin:/c/Program Files/Git/bin:/c/Program Files/Git/cmd:/c/Windows/System32\")",
      "Bash(export PATH=\"$PATH:/mingw64/bin:/usr/bin:/c/Program Files/Git/bin:/c/Program Files/Git/cmd:/c/Windows/System32:/c/Windows/System32/WindowsPowerShell/v1.0\")",
      "Bash(dir \"F:\\\\2026\\\\Repos2026\\\\dws6\\\\investor-outreach\\\\\" 2>/dev/null)"
    ]
  },
  "enabledMcpjsonServers": [
    "Supabase MCP",
    "Upstash Redis",
    "MCP Hub"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-commands.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sql-safety-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"file_path=\\$(jq -r '.tool_input.file_path // empty'); [ -n \\\"\\$file_path\\\" ] || exit 0; npx prettier --write -- \\\"\\$file_path\\\" 2>/dev/null || true; exit 0\""
          },
          {
            "type": "command",
            "command": "bash -lc \"file_path=\\$(jq -r '.tool_input.file_path // empty'); [ -n \\\"\\$file_path\\\" ] || exit 0; npx eslint --fix -- \\\"\\$file_path\\\" 2>&1 | tail -10; exit 0\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-stop.sh\""
          }
        ]
      }
    ]
  }
}
