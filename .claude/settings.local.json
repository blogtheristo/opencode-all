{
  "permissions": {
    "allow": [
      "Bash(powershell -Command:*)",
      "Bash(powershell -NoProfile -Command:*)",
      "Bash(pandoc:*)",
      "Bash(pip install:*)",
      "Bash(python -c:*)",
      "Bash(python -X utf8 -c:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(echo:*)",
      "Bash(git remote get-url:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-safety.sh\""
          }
        ]
      }
    ]
  }
}
