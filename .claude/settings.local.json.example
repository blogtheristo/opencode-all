{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "DO NOT copy this by hand. .claude/settings.local.json is generated from a per-environment profile: run scripts/Sync-ClaudeEnv.ps1 (Windows) or scripts/sync-claude-env.sh (Linux). The committed profiles in .claude/env/ are the recovery route for all four environments - see .claude/env/README.md. This file remains only as a schema reference.",
  "permissions": {
    "allow": []
  },
  "enabledMcpjsonServers": ["dws-gateway-local", "dws-agents-local"]
}
