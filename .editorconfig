# EditorConfig — DWS6 Code Formatting Baseline
# See: https://editorconfig.org
# See: SITE_QUALITY_STANDARDS.md §3 Code Formatting Standards

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

# JSON / YAML
[*.{json,jsonc,yaml,yml}]
indent_size = 2

# HTML / CSS
[*.{html,css,scss}]
indent_size = 2

# Markdown — preserve trailing whitespace (line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles — require tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# Python
[*.py]
indent_size = 4
max_line_length = 88

# SQL migrations
[*.sql]
indent_size = 2

# Docker
[Dockerfile*]
indent_size = 2

# Git config files
[.git*]
indent_size = 2
