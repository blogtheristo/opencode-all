# DWS IQ Auth Backend + Firehorse Pilot Configuration

# ============================================================================
# SERVER
# ============================================================================
ENV_SCHEMA_VERSION=1.1.0
PORT=3001
NODE_ENV=development

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================================
# SECRET VAULT (loads other secrets at startup — see src/config/secret-loader.ts)
# ============================================================================
# Preferred path is to keep this .env minimal and load the rest from a vault.
# When VAULT_PROVIDER is set, loadSecrets() fills any unset env vars from the
# vault on boot. Values already in process.env always win — never overwritten.
#
# VAULT_PROVIDER options:
#   aiven  — EU-sovereign (Finnish company, no CLOUD Act). RECOMMENDED for EU.
#            Stores secrets in Aiven PostgreSQL `app_secrets` (pgcrypto AES-256).
#            Needs AIVEN_DATABASE_URL + AIVEN_VAULT_KEY. `pg` package required.
#   gcp    — Google Cloud Secret Manager (US — CLOUD Act applies).
#            Needs GCP_PROJECT_ID + ADC credentials (metadata server / gcloud).
VAULT_PROVIDER=
GCP_PROJECT_ID=
# Aiven PostgreSQL vault connection (EU-sovereign secrets store).
# Created in https://console.aiven.io → Services → "dws-vault" (PostgreSQL, eu-north-1).
# Copy "Service URI" from the service overview page.
AIVEN_DATABASE_URL=
# Generate AIVEN_VAULT_KEY locally and store it separately from AIVEN_DATABASE_URL:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AIVEN_VAULT_KEY=
# Aiven API token for the `avn` CLI and mcp-aiven server.
# Create at https://console.aiven.io/profile/auth — scope: read+write, no expiry for prod,
# 24h for local dev. NEVER commit. Loaded into env only.
AIVEN_TOKEN=
# Legacy flag (use VAULT_PROVIDER=gcp instead)
GCP_SECRET_LOADER=

# ============================================================================
# CREDENTIAL BROKER (proxy: agents call here, broker injects vault creds upstream)
# ============================================================================
# Never give OpenClaw / Hermes raw Anthropic, OpenRouter, Telegram, or Gmail
# credentials. Instead, give each agent a capability token and point them at
# the broker at /api/v1/broker/<provider>/<upstream-path>. The broker validates
# the token, looks up the upstream credential from process.env (loaded from the
# vault on boot), forwards the request, and writes an audit log entry.
#
# BROKER_AGENT_TOKENS is a JSON map: {"agentId":{"tokenSha256":"<hex>","scopes":["anthropic","telegram"]}}
# Compute tokenSha256: node -e "console.log(require('crypto').createHash('sha256').update('<plaintext>').digest('hex'))"
# Plaintext token is what the agent sends as `Authorization: Bearer <token>`.
BROKER_AGENT_TOKENS=
# Optional HMAC key reserved for signed capability tokens (future).
BROKER_SIGNING_KEY=

# DWS API token for CLI and Cline (optional). Generate with:
#   node scripts/generate-cline-api-key.cjs
# Then set DWS_API_TOKEN=<output> or paste the token in Cline as API key when using a DWS endpoint.
# DWS_API_TOKEN=

# CORS - comma separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AI / LLM (Climate Assistant)
# ============================================================================
# Primary: Groq (fast + cheap) - uses Llama 3.1 70B
GROQ_API_KEY=your-groq-api-key-here

# Anthropic Claude (required for AI/DS Workflow Accelerator pipeline)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (multi-agent model selection — lite/standard tiers)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Ollama on Acer Veriton GN100 / DGX Spark (local inference — removes the metered
# per-token API bill; electricity, amortisation and serving remain a cost).
# OpenAI-compatible API — e.g. http://localhost:11434/v1 or http://[IPv6]:11434/v1
OLLAMA_BASE_URL=
# The two models actually pulled on the box. These MUST match
# OLLAMA_DEPLOYED_MODELS in src/agents/model-selector.ts, REQUIRED_MODELS in
# scripts/daily/check-ollama-models.sh, and the pulls in
# infrastructure/dgx-spark/deploy.sh — model-selector.test.ts asserts it.
# Changing them is a strategic decision requiring human approval.
OLLAMA_MODEL=nemotron-3-super
OLLAMA_MODEL_FAST=qwen3-coder:30b
# Optional server-side KV cache compression mode for Ollama startup/config.
# Example: q8_0 (stock Ollama), q4_0, or none depending on host support.
OLLAMA_KV_CACHE_TYPE=
# Optional extended context window passed per request to Ollama as num_ctx.
OLLAMA_NUM_CTX=

# vLLM on Acer Veriton GN100 (production-grade local serving)
# OpenAI-compatible API — e.g. http://localhost:8000/v1
VLLM_BASE_URL=
VLLM_API_KEY=

# ============================================================================
# DATABASE (if using)
# ============================================================================
DATABASE_URL=

# ============================================================================
# REDIS (if using)
# ============================================================================
REDIS_URL=

# ============================================================================
# SUPABASE (for Firehorse Pilot)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ============================================================================
# DATABASE BACKUP (pg_dump from Supabase)
# ============================================================================
# Direct PostgreSQL connection (NOT the PostgREST API URL)
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# GPG symmetric encryption passphrase for backup files
BACKUP_GPG_PASSPHRASE=your-strong-passphrase-here

# Local backup directory (Windows)
BACKUP_LOCAL_DIR=F:\2026\Backups\dws6-db

# Acer Veriton GN100 Helsinki (remote backup destination via SCP)
ACER_VERITON_HOST=your-veriton-ip-or-hostname
ACER_VERITON_USER=backup
ACER_VERITON_SSH_KEY=~/.ssh/id_ed25519_veriton
ACER_VERITON_BACKUP_DIR=/backups/dws6-db

# ============================================================================
# AIVEN POSTGRESQL (Sandbox / LWM Training)
# ============================================================================
# Daily mirror from Supabase for agent work and Lifetime World Model training.
# Set AIVEN_ENABLED=true after creating Aiven PostgreSQL service.
AIVEN_ENABLED=false
AIVEN_DB_HOST=your-project.aivencloud.com
AIVEN_DB_PORT=12345
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your-aiven-password
AIVEN_DB_SSLMODE=require
AIVEN_DATABASE_URL=postgresql://avnadmin:password@host:port/defaultdb?sslmode=require
# Encryption key for vault secrets (AES-256 via pgcrypto).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AIVEN_VAULT_KEY=

# Secret loading provider (optional)
# Use VAULT_PROVIDER=aiven or VAULT_PROVIDER=gcp to load missing env vars at startup.
# Legacy mode GCP_SECRET_LOADER=true is still supported.
VAULT_PROVIDER=
GCP_SECRET_LOADER=
GCP_PROJECT_ID=

# OpenClaw bridge (optional)
# OPENCLAW_ENDPOINT / OPENCLAW_API_KEY can be loaded by the vault provider above.
OPENCLAW_ENDPOINT=http://127.0.0.1:3100
OPENCLAW_API_KEY=
# Comma-separated DWS-approved skill names only. Community skills stay blocked.
OPENCLAW_ALLOWED_SKILLS=
OPENCLAW_TIMEOUT_MS=30000
OPENCLAW_MAX_RESPONSE_BYTES=1048576
OPENCLAW_LOG_BASE_PATH=/mnt/firehorse-dms/logs

# ============================================================================
# EMAIL SERVICE (for Firehorse Pilot)
# ============================================================================
EMAIL_SERVICE=resend
RESEND_API_KEY=your-resend-api-key

# From email address — must use verified Resend domain (onelifetime.world)
EMAIL_FROM=risto@onelifetime.world
FROM_NAME=Risto Anton Päärni

# ============================================================================
# SMTP — Primary sender (Amazon SES)
# Priority: SES (SMTP) > Resend (fallback) > console
# Domain onelifetime.world verified in SES. Region example: email-smtp.eu-north-1.amazonaws.com (Finland)
# SMTP_USER / SMTP_PASS = SES "SMTP credentials" from that region (SES console → SMTP settings), not raw IAM keys.
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: set true if SES SMTP hangs or fails on Windows (prefer IPv4 for DNS)
# SMTP_FORCE_IPV4=true

# Resend — fallback if SMTP not configured
RESEND_API_KEY=

# TED pipeline (construction_leads / ted_leads) — npm run ted:daily
# TED_OUTREACH_TO=risto@lifetime.fi
# TED_OUTREACH_DAILY_CAP=50
# TED_COMPLIANCE_FILTER=strict
# TED_COMPLIANCE_EXTRA=keyword1,keyword2
# TED_DAILY_RUN_OUTREACH=true
# TED_LEARNING_MIN_SENDS=50

# Outreach reply webhook sender allowlist (comma-separated).
# OUTREACH_DIGEST_EMAIL remains primary; this extends allowed sender aliases.
# OUTREACH_DIGEST_ALLOWED_SENDERS=risto.anton@lifetime.fi

# Payment service (Python FastAPI) - optional, for checkout flow
# PAYMENT_API_URL=http://localhost:8000
# SUPABASE_JWT_SECRET=  # Supabase JWT Secret (Project Settings > API) for dashboard token verification
# ============================================================================
# LINKEDIN API — Firehorse LinkedIn App
# ============================================================================
# App: "Firehorse LinkedIn" at https://www.linkedin.com/developers/apps
# Setup: npx tsx scripts/linkedin-oauth.ts   (runs local OAuth flow → prints token)

# App credentials (from LinkedIn Developer Portal → App → Auth)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OAuth 2.0 access token — expires every 60 days.
# Run: npx tsx scripts/linkedin-oauth.ts  to generate a new token.
LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token

# Author URN — personal profile or company page
# Personal:  urn:li:person:<memberId>   (auto-detected by linkedin-oauth.ts)
# Company:   urn:li:organization:<orgId> (from LinkedIn Company Admin → Admin tools)
LINKEDIN_AUTHOR_URN=urn:li:person:your-member-id

# ============================================================================
# FIREHORSE PILOT SETTINGS
# ============================================================================
# Enable/disable scheduler
FIREHORSE_SCHEDULER_ENABLED=true

# Daily job time (cron format: minute hour * * *)
FIREHORSE_DAILY_JOB_TIME=0 8 * * *

# Follow-up job interval (cron format)
FIREHORSE_FOLLOWUP_JOB_INTERVAL=0 */6 * * *

# Max new leads per day
FIREHORSE_MAX_DAILY_LEADS=30

# ============================================================================
# ERP INTEGRATIONS
# ============================================================================
# Enable/disable ERP scheduler
ERP_SCHEDULER_ENABLED=true

# Monitor ERP (Nordic SME market leader)
MONITOR_ERP_ENABLED=false
MONITOR_ERP_API_URL=https://api.monitor.se
MONITOR_ERP_CLIENT_ID=your-monitor-client-id
MONITOR_ERP_CLIENT_SECRET=your-monitor-client-secret
MONITOR_ERP_COMPANY_ID=your-company-id

# IFS Cloud (Asset-intensive manufacturing)
IFS_ENABLED=false
IFS_INSTANCE_URL=https://your-instance.ifs.cloud
IFS_OAUTH_TOKEN_URL=https://your-instance.ifs.cloud/auth/realms/your-realm/protocol/openid-connect/token
IFS_CLIENT_ID=your-ifs-client-id
IFS_CLIENT_SECRET=your-ifs-client-secret

# Microsoft Dynamics 365
DYNAMICS_365_ENABLED=false
DYNAMICS_365_ENVIRONMENT=org123.crm4.dynamics.com
DYNAMICS_365_TENANT_ID=your-tenant-id
DYNAMICS_365_CLIENT_ID=your-client-id
DYNAMICS_365_CLIENT_SECRET=your-client-secret
DYNAMICS_365_VERSION=business_central

# SAP S/4HANA
SAP_ENABLED=false
SAP_API_URL=https://your-sap-system.com
SAP_USERNAME=your-sap-username
SAP_PASSWORD=your-sap-password
SAP_CLIENT=100
SAP_SYSTEM_ID=PRD
SAP_ODATA_VERSION=v2

# Visma (Norwegian/Finnish mid-market)
VISMA_ENABLED=false
VISMA_API_URL=https://api.visma.net
VISMA_CLIENT_ID=your-visma-client-id
VISMA_CLIENT_SECRET=your-visma-client-secret
VISMA_COMPANY_ID=your-company-id
VISMA_PRODUCT=net

# Jeeves ERP (Swedish market)
JEEVES_ENABLED=false
JEEVES_API_URL=https://api.jeeves.se
JEEVES_API_KEY=your-jeeves-api-key
JEEVES_DATABASE_NAME=your-database-name

# ERP Approval Gate Settings
ERP_APPROVAL_GATE_ENABLED=true
ERP_AUTO_APPROVE_LOW_RISK=true
ERP_APPROVAL_TIMEOUT_MINUTES=60
ERP_REQUIRE_DUAL_APPROVAL=true

# ============================================================================
# ESG / SUSTAINABILITY INTEGRATIONS
# ============================================================================
# Worldfavor (Nordic ESG platform)
WORLDFAVOR_ENABLED=false
WORLDFAVOR_API_URL=https://api.worldfavor.com
WORLDFAVOR_API_KEY=your-worldfavor-api-key
WORLDFAVOR_ORGANIZATION_ID=your-org-id

# Position Green (Nordic sustainability reporting)
POSITION_GREEN_ENABLED=false
POSITION_GREEN_API_URL=https://api.positiongreen.com
POSITION_GREEN_API_KEY=your-position-green-api-key

# ============================================================================
# EXA SEARCH (web search + Websets people/company search for OpenClaw/Firehorse)
# ============================================================================
# Canonical docs: https://docs.exa.ai/reference/exa-mcp
# Registration:   mcp-hub/config/exa-mcp.json
#
# Two paths — pick ONE:
#   1. MCP + OAuth (recommended for compliance) — no key here; browser sign-in
#      on first connect to https://mcp.exa.ai/mcp. Leave EXA_API_KEY empty.
#   2. Native OpenClaw web-search provider — set EXA_API_KEY and run
#      `openclaw configure --section web`. Manage keys at
#      https://dashboard.exa.ai/api-keys
#
# IMPORTANT: Reasoning over Exa tool output MUST run on DGX Spark Ollama
# (EU sovereignty). Do NOT pipe Exa results into Anthropic/OpenAI inference.
# See skills/ollama-spark and CLAUDE.md.
EXA_API_KEY=
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_TOOLS=web_search_exa,web_fetch_exa,web_search_advanced_exa
EXA_LATENCY_MODE=auto

# ============================================================================
# OBSERVABILITY — OpenTelemetry tracing (optional)
# ============================================================================
# Disabled when OTEL_EXPORTER_OTLP_ENDPOINT is empty. Point at any OTLP/HTTP
# collector. Keep it EU-hosted for sovereignty (Grafana Cloud EU, self-hosted
# Tempo, Honeycomb EU, Langfuse EU). Exporter POSTs to <endpoint>/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated k=v pairs, e.g. "authorization=Bearer xyz,x-tenant=lifetime"
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=dws-iq-backend
OTEL_SERVICE_VERSION=1.0.0
# Set to "debug" to log SDK internals while wiring this up.
OTEL_LOG_LEVEL=

# --- CBAM pilot evidence signing (src/services/cbam-pilot.service.ts) ---
# When set, CBAM evidence envelopes carry a real keyed HMAC-SHA256 signature.
# When unset the envelope falls back to an unkeyed SHA-256 digest and is
# labelled integrity_only=true - it is NOT valid attribution evidence.
CBAM_SIGNING_KEY=
CBAM_SIGNING_KEY_ID=dws-cbam-pilot

# --- Cloudflare workflows worker (cloudflare-workflows/src/index.ts) ---
# Bearer token required by POST /workflows/approve/* and GET /workflows/status/*.
# Both endpoints fail closed (401) when this is unset.
WORKFLOW_API_TOKEN=
