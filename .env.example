# DWS IQ Auth Backend + Firehorse Pilot Configuration

# ============================================================================
# SERVER
# ============================================================================
PORT=3001
NODE_ENV=development

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# CORS - comma separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AI / LLM (Climate Assistant)
# ============================================================================
# Primary: Groq (fast + cheap) - uses Llama 3.1 70B
GROQ_API_KEY=your-groq-api-key-here

# Alternative: Anthropic Claude (if needed)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================================
# DATABASE (if using)
# ============================================================================
DATABASE_URL=

# ============================================================================
# REDIS (if using)
# ============================================================================
REDIS_URL=

# ============================================================================
# SUPABASE (for Firehorse Pilot)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ============================================================================
# EMAIL SERVICE (for Firehorse Pilot)
# ============================================================================
# Choose one: resend, gmail
EMAIL_SERVICE=resend

# Resend (primary)
RESEND_API_KEY=your-resend-api-key

# Gmail SMTP fallback (App Password — not your login password)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# From email address (used by email.service.ts as EMAIL_FROM)
EMAIL_FROM=risto@lifetime.fi
FROM_NAME=Risto Anton Päärni

# ============================================================================
# FIREHORSE PILOT SETTINGS
# ============================================================================
# Enable/disable scheduler
FIREHORSE_SCHEDULER_ENABLED=true

# Daily job time (cron format: minute hour * * *)
FIREHORSE_DAILY_JOB_TIME=0 8 * * *

# Follow-up job interval (cron format)
FIREHORSE_FOLLOWUP_JOB_INTERVAL=0 */6 * * *

# Max new leads per day
FIREHORSE_MAX_DAILY_LEADS=30

# ============================================================================
# ERP INTEGRATIONS
# ============================================================================
# Enable/disable ERP scheduler
ERP_SCHEDULER_ENABLED=true

# Monitor ERP (Nordic SME market leader)
MONITOR_ERP_ENABLED=false
MONITOR_ERP_API_URL=https://api.monitor.se
MONITOR_ERP_CLIENT_ID=your-monitor-client-id
MONITOR_ERP_CLIENT_SECRET=your-monitor-client-secret
MONITOR_ERP_COMPANY_ID=your-company-id

# IFS Cloud (Asset-intensive manufacturing)
IFS_ENABLED=false
IFS_INSTANCE_URL=https://your-instance.ifs.cloud
IFS_OAUTH_TOKEN_URL=https://your-instance.ifs.cloud/auth/realms/your-realm/protocol/openid-connect/token
IFS_CLIENT_ID=your-ifs-client-id
IFS_CLIENT_SECRET=your-ifs-client-secret

# Microsoft Dynamics 365
DYNAMICS_365_ENABLED=false
DYNAMICS_365_ENVIRONMENT=org123.crm4.dynamics.com
DYNAMICS_365_TENANT_ID=your-tenant-id
DYNAMICS_365_CLIENT_ID=your-client-id
DYNAMICS_365_CLIENT_SECRET=your-client-secret
DYNAMICS_365_VERSION=business_central

# SAP S/4HANA
SAP_ENABLED=false
SAP_API_URL=https://your-sap-system.com
SAP_USERNAME=your-sap-username
SAP_PASSWORD=your-sap-password
SAP_CLIENT=100
SAP_SYSTEM_ID=PRD
SAP_ODATA_VERSION=v2

# Visma (Norwegian/Finnish mid-market)
VISMA_ENABLED=false
VISMA_API_URL=https://api.visma.net
VISMA_CLIENT_ID=your-visma-client-id
VISMA_CLIENT_SECRET=your-visma-client-secret
VISMA_COMPANY_ID=your-company-id
VISMA_PRODUCT=net

# Jeeves ERP (Swedish market)
JEEVES_ENABLED=false
JEEVES_API_URL=https://api.jeeves.se
JEEVES_API_KEY=your-jeeves-api-key
JEEVES_DATABASE_NAME=your-database-name

# ERP Approval Gate Settings
ERP_APPROVAL_GATE_ENABLED=true
ERP_AUTO_APPROVE_LOW_RISK=true
ERP_APPROVAL_TIMEOUT_MINUTES=60
ERP_REQUIRE_DUAL_APPROVAL=true

# ============================================================================
# ESG / SUSTAINABILITY INTEGRATIONS
# ============================================================================
# Worldfavor (Nordic ESG platform)
WORLDFAVOR_ENABLED=false
WORLDFAVOR_API_URL=https://api.worldfavor.com
WORLDFAVOR_API_KEY=your-worldfavor-api-key
WORLDFAVOR_ORGANIZATION_ID=your-org-id

# Position Green (Nordic sustainability reporting)
POSITION_GREEN_ENABLED=false
POSITION_GREEN_API_URL=https://api.positiongreen.com
POSITION_GREEN_API_KEY=your-position-green-api-key
