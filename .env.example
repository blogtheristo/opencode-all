# DWS IQ Auth Backend + Firehorse Pilot Configuration

# ============================================================================
# SERVER
# ============================================================================
#
# Environment schema version (tracks structure changes of this template only)
# Bump major/minor/patch per DWS_DOCUMENT_STANDARD.md §19.5
ENV_SCHEMA_VERSION=1.0.0

PORT=3001
NODE_ENV=development

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# DWS API token for CLI and Cline (optional). Generate with:
#   node scripts/generate-cline-api-key.cjs
# Then set DWS_API_TOKEN=<output> or paste the token in Cline as API key when using a DWS endpoint.
# DWS_API_TOKEN=

# CORS - comma separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AI / LLM (Climate Assistant)
# ============================================================================
# Primary: Groq (fast + cheap) - uses Llama 3.1 70B
GROQ_API_KEY=your-groq-api-key-here

# Anthropic Claude (required for AI/DS Workflow Accelerator pipeline)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama (GN100 edge / local inference — keyless by default)
# Set OLLAMA_HOST to enable. No API key needed for local Ollama.
# SSH tunnel: ssh -L 11434:127.0.0.1:11434 admin100@gn100-cb5d
# Direct:    http://gn100-cb5d:11434 (if bound to 0.0.0.0)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# OLLAMA_API_KEY=  # Only needed for Ollama Cloud subscriptions

# ============================================================================
# DATABASE (if using)
# ============================================================================
DATABASE_URL=

# ============================================================================
# REDIS (if using)
# ============================================================================
REDIS_URL=

# ============================================================================
# SUPABASE (for Firehorse Pilot)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ============================================================================
# DATABASE BACKUP (pg_dump from Supabase)
# ============================================================================
# Direct PostgreSQL connection (NOT the PostgREST API URL)
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# GPG symmetric encryption passphrase for backup files
BACKUP_GPG_PASSPHRASE=your-strong-passphrase-here

# Local backup directory (Windows)
BACKUP_LOCAL_DIR=F:\2026\Backups\dws6-db

# Acer Veriton GN100 Helsinki (remote backup destination via SCP)
ACER_VERITON_HOST=your-veriton-ip-or-hostname
ACER_VERITON_USER=backup
ACER_VERITON_SSH_KEY=~/.ssh/id_ed25519_veriton
ACER_VERITON_BACKUP_DIR=/backups/dws6-db

# Win11 (secondary backup destination via SCP)
WIN11_BACKUP_HOST=your-win11-ip-or-hostname
WIN11_BACKUP_USER=risto
WIN11_BACKUP_SSH_KEY=~/.ssh/id_ed25519
WIN11_BACKUP_DIR=F:/2026/Backups/dws6-db

# Acer Veriton edge PostgreSQL (local replica target)
EDGE_PG_HOST=localhost
EDGE_PG_PORT=5432
EDGE_PG_USER=dws_edge
EDGE_PG_PASSWORD=your-edge-postgres-password
EDGE_PG_DATABASE=dws_edge

# ============================================================================
# AIVEN POSTGRESQL (Sandbox / LWM Training)
# ============================================================================
# Daily mirror from Supabase for agent work and Lifetime World Model training.
# Set AIVEN_ENABLED=true after creating Aiven PostgreSQL service.
AIVEN_ENABLED=false
AIVEN_DB_HOST=your-project.aivencloud.com
AIVEN_DB_PORT=12345
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your-aiven-password
AIVEN_DB_SSLMODE=require
AIVEN_DATABASE_URL=postgresql://avnadmin:password@host:port/defaultdb?sslmode=require

# ============================================================================
# EMAIL SERVICE (for Firehorse Pilot)
# Default sender: risto@onelifetime.world (verified in SES + Resend.com)
# ============================================================================
EMAIL_FROM=risto@onelifetime.world
FROM_NAME=Risto Anton Päärni

# ============================================================================
# SMTP — Primary sender (Amazon SES)
# Priority: SES (SMTP) > Resend (fallback) > console
# Domain onelifetime.world verified in SES. Region example: email-smtp.eu-north-1.amazonaws.com (Finland)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend — fallback if SMTP not configured
RESEND_API_KEY=

# Payment service (Python FastAPI) - optional, for checkout flow
# PAYMENT_API_URL=http://localhost:8000
# SUPABASE_JWT_SECRET=  # Supabase JWT Secret (Project Settings > API) for dashboard token verification

# ============================================================================
# LINKEDIN API — Firehorse LinkedIn App
# ============================================================================
# App: "Firehorse LinkedIn" at https://www.linkedin.com/developers/apps
# Setup: npx tsx scripts/linkedin-oauth.ts   (runs local OAuth flow → prints token)

# App credentials (from LinkedIn Developer Portal → App → Auth)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OAuth 2.0 access token — expires every 60 days.
# Run: npx tsx scripts/linkedin-oauth.ts  to generate a new token.
LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token

# Author URN — personal profile or company page
# Personal:  urn:li:person:<memberId>   (auto-detected by linkedin-oauth.ts)
# Company:   urn:li:organization:<orgId> (from LinkedIn Company Admin → Admin tools)
LINKEDIN_AUTHOR_URN=urn:li:person:your-member-id

# --- X (Twitter) API ---
# Create app at https://developer.x.com/ with OAuth 1.0a read+write
X_API_KEY=your-x-consumer-api-key
X_API_SECRET=your-x-consumer-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# ============================================================================
# FIREHORSE PILOT SETTINGS
# ============================================================================
# Enable/disable scheduler
FIREHORSE_SCHEDULER_ENABLED=true

# Daily job time (cron format: minute hour * * *)
FIREHORSE_DAILY_JOB_TIME=0 8 * * *

# Follow-up job interval (cron format)
FIREHORSE_FOLLOWUP_JOB_INTERVAL=0 */6 * * *

# Max new leads per day
FIREHORSE_MAX_DAILY_LEADS=30

# ============================================================================
# ERP INTEGRATIONS
# ============================================================================
# Enable/disable ERP scheduler
ERP_SCHEDULER_ENABLED=true

# Monitor ERP (Nordic SME market leader)
MONITOR_ERP_ENABLED=false
MONITOR_ERP_API_URL=https://api.monitor.se
MONITOR_ERP_CLIENT_ID=your-monitor-client-id
MONITOR_ERP_CLIENT_SECRET=your-monitor-client-secret
MONITOR_ERP_COMPANY_ID=your-company-id

# IFS Cloud (Asset-intensive manufacturing)
IFS_ENABLED=false
IFS_INSTANCE_URL=https://your-instance.ifs.cloud
IFS_OAUTH_TOKEN_URL=https://your-instance.ifs.cloud/auth/realms/your-realm/protocol/openid-connect/token
IFS_CLIENT_ID=your-ifs-client-id
IFS_CLIENT_SECRET=your-ifs-client-secret

# Microsoft Dynamics 365
DYNAMICS_365_ENABLED=false
DYNAMICS_365_ENVIRONMENT=org123.crm4.dynamics.com
DYNAMICS_365_TENANT_ID=your-tenant-id
DYNAMICS_365_CLIENT_ID=your-client-id
DYNAMICS_365_CLIENT_SECRET=your-client-secret
DYNAMICS_365_VERSION=business_central

# SAP S/4HANA
SAP_ENABLED=false
SAP_API_URL=https://your-sap-system.com
SAP_USERNAME=your-sap-username
SAP_PASSWORD=your-sap-password
SAP_CLIENT=100
SAP_SYSTEM_ID=PRD
SAP_ODATA_VERSION=v2

# Visma (Norwegian/Finnish mid-market)
VISMA_ENABLED=false
VISMA_API_URL=https://api.visma.net
VISMA_CLIENT_ID=your-visma-client-id
VISMA_CLIENT_SECRET=your-visma-client-secret
VISMA_COMPANY_ID=your-company-id
VISMA_PRODUCT=net

# Jeeves ERP (Swedish market)
JEEVES_ENABLED=false
JEEVES_API_URL=https://api.jeeves.se
JEEVES_API_KEY=your-jeeves-api-key
JEEVES_DATABASE_NAME=your-database-name

# ERP Approval Gate Settings
ERP_APPROVAL_GATE_ENABLED=true
ERP_AUTO_APPROVE_LOW_RISK=true
ERP_APPROVAL_TIMEOUT_MINUTES=60
ERP_REQUIRE_DUAL_APPROVAL=true

# ============================================================================
# ESG / SUSTAINABILITY INTEGRATIONS
# ============================================================================
# Worldfavor (Nordic ESG platform)
WORLDFAVOR_ENABLED=false
WORLDFAVOR_API_URL=https://api.worldfavor.com
WORLDFAVOR_API_KEY=your-worldfavor-api-key
WORLDFAVOR_ORGANIZATION_ID=your-org-id

# Position Green (Nordic sustainability reporting)
POSITION_GREEN_ENABLED=false
POSITION_GREEN_API_URL=https://api.positiongreen.com
POSITION_GREEN_API_KEY=your-position-green-api-key

# --- EC3 / BuildingTransparency (EPD data for Material Oracle) ---
EC3_API_TOKEN=your-ec3-api-token
EC3_GEOGRAPHY_FILTER=FI,SE,NO,DK,DE

# --- DocuSign eSignature ---
DOCUSIGN_ENABLED=false
DOCUSIGN_ENVIRONMENT=demo
DOCUSIGN_INTEGRATION_KEY=3fc9680c-fae6-41bc-93eb-3f4377db51d0
DOCUSIGN_USER_ID=5f700ff5-51dc-4a06-8e57-e416a710bee8
DOCUSIGN_ACCOUNT_ID=6eb1e2af-f0f0-475f-9464-a3cc17c4d8d1
DOCUSIGN_RSA_PRIVATE_KEY=your-rsa-private-key-contents

# ============================================================================
# ERROR TRACKING (SENTRY)
# ============================================================================
# Set SENTRY_DSN to enable Sentry error tracking (gracefully falls back to console if unset)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
APP_VERSION=dws-iq-6@1.0.0

# ============ OPEN DATA FEEDS (Compliance Ledger) ============
# ENTSO-E Transparency Platform — real-time grid emission factors
# Register: https://transparency.entsoe.eu/ (free)
# Without key: falls back to static country averages
ENTSOE_API_KEY=

# EMBER Carbon Price — no API key required for basic access
# Endpoint auto-configured. Set to 'disabled' to force static EUR 65 fallback.
# EMBER_CARBON_PRICE=enabled
