# =============================================================================
# DWS6 .gitignore - Cleaned February 6, 2026
# =============================================================================
# PRINCIPLE: This is a PRIVATE repo. Only ignore:
#   1. Actual secrets/credentials (API keys, passwords, tokens)
#   2. Build artifacts and dependencies (node_modules, dist, venv)
#   3. OS/IDE junk files
# Everything else (docs, admin, business files) MUST be tracked so
# Claude Code cloud sessions can read/write them without data loss.
# =============================================================================

# --- SECRETS & CREDENTIALS (MUST stay gitignored) ---
.env
.env.*
.env.local
.env.*.local
.env.mcp
env100326.mcp
[0-9][0-9][0-9][0-9][0-9][0-9].env
[0-9][0-9][0-9][0-9][0-9][0-9]mcp.env
.mcp.json
credentials.json
service-account-*.json
google-services.json
claude_config.json
SFTP_SECRETS.py
CLOUDFLARE_SECRETS.md
ADD_TOKEN_TO_GITHUB.md
*.key
*.pem
*.secret
*.jks
*.keystore
# SSH/private key files (e.g., id_ed25519, id_rsa, id_xx + optional .pub)
id_*
id_*.pub
nul
supabase/.env
supabase/.env.local
supabase/.temp/
dws6.com/**/.env.local
dws6.com/**/.env.*.local
dws6.com/**/config/*.local.js

# --- RUNTIME LOGS ---
logs/
*.log

# Clawdbot queue + state are gitignored down in the .claude/* section.

# --- BUILD ARTIFACTS & DEPENDENCIES ---
**/node_modules/
**/.next/
**/out/
**/.vercel/
**/.turbo/
dist/
build/
.gradle/
__pycache__/
*.pyc
venv/
.venv/
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json
*.hprof

# --- OS & IDE FILES ---
.DS_Store
Thumbs.db
*.iml
.idea/
# Ignore .claude contents but whitelist hooks + settings + skills for team safety nets
.claude/*
!.claude/HANDOFF.md
!.claude/hooks/
!.claude/settings.json
!.claude/settings.local.json
!.claude/archive/
!.claude/commands/
!.claude/commands/*.md
!.claude/agents/
!.claude/clawdbot/
.claude/clawdbot/queue/
.claude/clawdbot/state.json
.claude/hooks/audit/
.claude/command-log.txt
claude-output.json
review-output.json
nul
# .vscode/ is tracked - contains shared tasks.json for sync tools
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
local.properties
.cursor/rules/snyk_rules.mdc

# --- LOGS ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
mcp-hub/*.log
mcp-servers/**/*.log
*.security.log
security_*.log

# --- DATABASE BACKUPS (never commit binary dumps) ---
*.dump
*.dump.gpg
*.pgdump
backups/db/

# --- DOCKER VOLUMES (runtime data, not source) ---
mcp-context-data/
claude-sessions/

# --- PROTON DRIVE SYNC (if repo is inside Proton folder) ---
**/Proton Drive/
**/ProtonDrive/

# --- GDPR: ACTUAL CUSTOMER PII DATA (not documentation ABOUT customers) ---
# Only ignore folders that contain real personal data exports
*.csv
!landing-pages/dws10-com/products.csv
!dws10.com/products.csv
!Learn/data/activation/billing-*.csv
investor-outreach/ready_to_send*/
scripts/investor-contacts.local.json

# --- REPO ARTIFACTS (directory listings, temp files accidentally committed) ---
# Ignore the artifacts/ tree (large binaries + PR/worktree snapshots) by default,
# but TRACK Core Artifact knowledge files (ART-*.md) and category folders so the
# §5 Artifact Framework is source-of-truth and version-controlled.
artifacts/*
!artifacts/README.md
!artifacts/*/
artifacts/*/*
!artifacts/*/ART-*.md
diret
mcp.json
pr-description.md
"package.json (to be modified)"

# --- ML/DS PIPELINE ARTIFACTS (generated per run, not source) ---
reports/figures/*.png
reports/*.json
models/*.pkl

# --- SNYK/SECURITY SCAN OUTPUT (auto-generated, not source) ---
snyk.sarif
.snykdist
pip-audit-report.json
safety-report.json
*-security-report.json
sbom.json

# Codebase health reports (generated by scripts/codebase_health.py --output-file)
health_report.json
# --- ML PIPELINE ARTIFACTS (generated outputs, not source) ---
# Generated by workflow/ pipeline - these are runtime outputs
reports/figures/*.png
reports/*.json
scripts/sync-report.json
models/*.pkl
data/raw_dataset.csv
data/cleaned_dataset.csv

/.env.old
