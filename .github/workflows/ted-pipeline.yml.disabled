# TED pipeline — 06:00 UTC: fetch tenders → compliance/CPV filter → ERP hint → Supabase;
# optional second step: SES outreach batch (50/day cap). Follow-up + weekly learning: separate schedules.
#
# Secrets: SUPABASE_URL, SUPABASE_SERVICE_KEY, SMTP_*, TED_OUTREACH_TO (or OUTREACH_DIGEST_EMAIL),
# EMAIL_FROM. Optional: TED_DAILY_RUN_OUTREACH=false to fetch-only.

name: TED Pipeline

on:
  # Schedule REMOVED 2026-05-25 (#1384) — DGX Spark is primary (scripts/daily/ted-pipeline.sh)
  # Was: cron '0 6 * * *' (daily at 06:00 UTC)
  workflow_dispatch:
    inputs:
      fetch_only:
        description: 'Run TED fetch only (no outreach send)'
        required: false
        default: false
        type: boolean

jobs:
  ted-run:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - uses: actions/checkout@v4

      # DGX Spark runs scripts/daily/ted-pipeline.sh as primary.
      # This GHA workflow is failover only; skip if DGX is alive.
      - name: DGX Spark failover check
        id: failover
        uses: ./.github/actions/dgx-failover-check
        with:
          heartbeat_url: ${{ vars.DGX_SPARK_HEARTBEAT_URL }}

      - name: Skip if DGX is primary
        if: steps.failover.outputs.dgx_alive == 'true'
        run: |
          echo "DGX Spark is healthy — TED pipeline runs there. Exiting."
          exit 0

      - uses: actions/setup-node@v4
        if: steps.failover.outputs.dgx_alive != 'true'
        with:
          node-version: '24'
          cache: npm

      - name: Install dependencies
        if: steps.failover.outputs.dgx_alive != 'true'
        run: npm ci --ignore-scripts

      - name: TED fetch + optional outreach
        if: steps.failover.outputs.dgx_alive != 'true'
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT || '587' }}
          SMTP_SECURE: ${{ secrets.SMTP_SECURE || 'false' }}
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASS: ${{ secrets.SMTP_PASS }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          EMAIL_FROM: ${{ secrets.EMAIL_FROM || 'risto@onelifetime.world' }}
          TED_OUTREACH_TO: ${{ secrets.TED_OUTREACH_TO || secrets.OUTREACH_DIGEST_EMAIL }}
          OUTREACH_DIGEST_EMAIL: ${{ secrets.OUTREACH_DIGEST_EMAIL }}
          TED_DAILY_RUN_OUTREACH: ${{ github.event.inputs.fetch_only == 'true' && 'false' || 'true' }}
        run: node --import tsx scripts/ted-daily-pipeline.ts
