# Weekly Report — Product Agent Coordination
#
# Generates weekly status report (EN/FI) per AGENTS.md §12.
# Schedule: Monday 09:00 UTC (per WORKFLOW_REGISTRY.json)
# Product Agent compiles final report; creates GitHub issue and emails report.
# Email: risto@onelifetime.world (Amazon SES) → risto@lifetime.fi

# PRIMARY: DGX Spark (24/7, cron-runner.ts)
# FAILOVER: This GitHub Actions workflow (checks DGX heartbeat first)
name: Weekly Report

on:
  schedule:
    - cron: '0 9 * * 1'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  weekly-report:
    name: Weekly Report
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: DGX Spark failover check
        id: failover
        uses: ./.github/actions/dgx-failover-check
        with:
          heartbeat_url: ${{ secrets.DGX_SPARK_HEARTBEAT_URL }}

      - name: Skip if DGX Spark is handling this
        if: steps.failover.outputs.dgx_alive == 'true' && github.event_name == 'schedule'
        run: |
          echo "DGX Spark is alive — skipping (failover mode)"
          exit 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Generate weekly report
        id: report
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          WEEK=$(date -u '+%Y-W%V')
          DATE=$(date -u '+%Y-%m-%d')
          echo "## Weekly Report — $WEEK" > report.md
          echo "" >> report.md
          echo "**Generated:** $(date -u '+%Y-%m-%d %H:%M UTC')" >> report.md
          echo "" >> report.md

          # Commit summary (last 7 days)
          echo "### Commits This Week" >> report.md
          echo "" >> report.md
          COMMITS=$(git log --since="7 days ago" --oneline --no-merges | head -30)
          if [ -z "$COMMITS" ]; then
            echo "- No commits in the last 7 days" >> report.md
          else
            echo "$COMMITS" | sed 's/^/- /' >> report.md
          fi
          echo "" >> report.md

          # Open PRs
          echo "### Open PRs" >> report.md
          echo "" >> report.md
          OPEN_PR_COUNT=$(gh pr list --state open --limit 100 --json number | jq length)
          echo "| Metric | Count |" >> report.md
          echo "|--------|-------|" >> report.md
          echo "| Open PRs | $OPEN_PR_COUNT |" >> report.md
          echo "" >> report.md

          # Merged this week
          WEEK_AGO=$(date -u -d '7 days ago' '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -v-7d '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo "1970-01-01T00:00:00Z")
          MERGED=$(gh pr list --state merged --limit 50 --json number,title,mergedAt \
            --jq ".[] | select(.mergedAt >= \"$WEEK_AGO\") | \"- #\(.number) \(.title)\"" 2>/dev/null || echo "")
          echo "### Merged This Week" >> report.md
          echo "" >> report.md
          if [ -z "$MERGED" ]; then
            echo "- No PRs merged this week" >> report.md
          else
            echo "$MERGED" >> report.md
          fi
          echo "" >> report.md

          echo "---" >> report.md
          echo "" >> report.md
          echo "*Product Agent compiles final EN/FI report. See AGENTS.md §12.*" >> report.md

          echo "week=$WEEK" >> $GITHUB_OUTPUT

      - name: Create or update weekly report issue
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          WEEK=${{ steps.report.outputs.week }}
          TITLE="Weekly Report — $WEEK"

          gh label create "weekly-report" --repo ${{ github.repository }} --color "0075ca" --description "Weekly status report" 2>/dev/null || true

          EXISTING=$(gh issue list --repo ${{ github.repository }} --label "weekly-report" --search "$TITLE" --json number --jq '.[0].number' 2>/dev/null || echo "")

          if [ -n "$EXISTING" ] && [ "$EXISTING" != "null" ]; then
            gh issue comment "$EXISTING" --repo ${{ github.repository }} --body-file report.md
          else
            gh issue create \
              --repo ${{ github.repository }} \
              --title "$TITLE" \
              --body-file report.md \
              --label "weekly-report"
          fi

      - name: Send weekly report email
        env:
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT || '587' }}
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASS: ${{ secrets.SMTP_PASS }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          EMAIL_FROM: risto@onelifetime.world
          OUTREACH_DIGEST_EMAIL: risto@lifetime.fi
        run: npx tsx scripts/send-weekly-report-email.ts report.md || true
