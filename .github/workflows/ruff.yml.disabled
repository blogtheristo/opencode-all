name: Ruff Linting & Formatting

on:
  pull_request:
    paths:
      - '**.py'
  push:
    branches: [main]

permissions:
  contents: read
  pull-requests: write

jobs:
  ruff:
    name: Ruff Check
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install Ruff
        run: pip install ruff
      
      - name: Run Ruff Linter
        run: |
          echo "🔍 Running Ruff linter..."
          ruff check . --output-format=github
      
      - name: Run Ruff Formatter Check
        run: |
          echo "🎨 Checking code formatting..."
          ruff format --check .
      
      - name: Generate Ruff Report
        if: always()
        run: |
          echo "📊 Generating detailed report..."
          ruff check . --output-format=json > ruff-report.json || true
          ruff check . --statistics
      
      - name: Upload Ruff Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ruff-report
          path: ruff-report.json
          retention-days: 30
      
      - name: Comment PR with Ruff Results
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let comment = '## 🐶 Ruff Code Quality Report\n\n';
            
            try {
              const report = JSON.parse(fs.readFileSync('ruff-report.json', 'utf8'));
              
              if (report.length === 0) {
                comment += '✅ **No issues found!** Your code is clean and well-formatted.\n\n';
              } else {
                const errorCount = report.filter(r => r.severity === 'error').length;
                const warningCount = report.filter(r => r.severity === 'warning').length;
                
                comment += `### Summary\n`;
                comment += `- 🔴 **Errors:** ${errorCount}\n`;
                comment += `- 🟡 **Warnings:** ${warningCount}\n`;
                comment += `- 📝 **Total Issues:** ${report.length}\n\n`;
                
                if (report.length > 0 && report.length <= 10) {
                  comment += '### Issues Found\n\n';
                  report.slice(0, 10).forEach(issue => {
                    const icon = issue.severity === 'error' ? '🔴' : '🟡';
                    comment += `${icon} **${issue.code}**: ${issue.message}\n`;
                    comment += `   📁 \`${issue.filename}:${issue.location.row}\`\n\n`;
                  });
                } else if (report.length > 10) {
                  comment += `### Top 10 Issues\n\n`;
                  report.slice(0, 10).forEach(issue => {
                    const icon = issue.severity === 'error' ? '🔴' : '🟡';
                    comment += `${icon} **${issue.code}**: ${issue.message}\n`;
                    comment += `   📁 \`${issue.filename}:${issue.location.row}\`\n\n`;
                  });
                  comment += `\n... and ${report.length - 10} more issues.\n\n`;
                }
                
                comment += '### 🔧 Auto-Fix Available\n';
                comment += 'Run `ruff check --fix` to automatically fix many of these issues.\n\n';
              }
            } catch (e) {
              comment += '✅ **Linting completed successfully!**\n\n';
            }
            
            comment += '---\n';
            comment += '*Powered by [Ruff](https://github.com/astral-sh/ruff) - An extremely fast Python linter*';
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });
