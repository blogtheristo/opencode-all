# PRIMARY: DGX Spark (24/7, cron-runner.ts)
# FAILOVER: This GitHub Actions workflow (checks DGX heartbeat first)
name: Weekly Campaign Newsletter

on:
  schedule:
    - cron: '0 5 * * 5'
    - cron: '0 6 * * 5'
  workflow_dispatch:
    inputs:
      force_send:
        description: 'Force send newsletter regardless of time check'
        type: boolean
        default: false

env:
  NODE_VERSION: '24'

jobs:
  send-newsletter:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4
        with:
          sparse-checkout: .github/actions
          sparse-checkout-cone-mode: true

      - name: DGX Spark failover check
        id: failover
        uses: ./.github/actions/dgx-failover-check
        with:
          heartbeat_url: ${{ secrets.DGX_SPARK_HEARTBEAT_URL }}

      - name: Skip if DGX Spark is handling this
        if: steps.failover.outputs.dgx_alive == 'true' && github.event_name == 'schedule'
        run: |
          echo "DGX Spark is alive — skipping (failover mode)"
          exit 0

      - name: Helsinki time guard
        id: time-check
        run: |
          HELSINKI_HOUR=$(TZ='Europe/Helsinki' date +%H)
          echo "Helsinki hour: $HELSINKI_HOUR"
          if [ "${{ github.event_name }}" = "schedule" ] && [ "$HELSINKI_HOUR" != "08" ]; then
            echo "skip=true" >> $GITHUB_OUTPUT
          else
            echo "skip=false" >> $GITHUB_OUTPUT
          fi

      - name: Checkout
        if: steps.time-check.outputs.skip != 'true'
        uses: actions/checkout@v4

      - name: Setup Node.js
        if: steps.time-check.outputs.skip != 'true'
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        if: steps.time-check.outputs.skip != 'true'
        run: npm ci

      - name: Collect week's posts and send digest
        if: steps.time-check.outputs.skip != 'true'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          AWS_SES_SMTP_USER: ${{ secrets.AWS_SES_SMTP_USER }}
          AWS_SES_SMTP_PASS: ${{ secrets.AWS_SES_SMTP_PASS }}
          AWS_SES_SMTP_HOST: ${{ secrets.AWS_SES_SMTP_HOST }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
          EMAIL_FROM: 'risto@onelifetime.world'
        run: npx tsx scripts/send-campaign-newsletter.ts

  notify-on-failure:
    needs: send-newsletter
    if: failure()
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install and notify
        env:
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          AWS_SES_SMTP_USER: ${{ secrets.AWS_SES_SMTP_USER }}
          AWS_SES_SMTP_PASS: ${{ secrets.AWS_SES_SMTP_PASS }}
          AWS_SES_SMTP_HOST: ${{ secrets.AWS_SES_SMTP_HOST }}
          EMAIL_FROM: 'risto@onelifetime.world'
        run: |
          npm ci
          npx tsx -e "
          import { sendEmail } from './src/utils/send-email.js';
          await sendEmail({
            to: 'risto@lifetime.fi',
            from: process.env.EMAIL_FROM || 'risto@onelifetime.world',
            subject: '🚨 Weekly Newsletter FAILED',
            html: '<h2>Weekly Campaign Newsletter Failed</h2><p><a href=\"https://github.com/blogtheristo/dws6/actions/runs/${{ github.run_id }}\">View logs</a></p>',
            text: 'Newsletter failed. Check: https://github.com/blogtheristo/dws6/actions/runs/${{ github.run_id }}'
          });
          "
