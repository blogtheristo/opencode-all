name: Dependency Review & Security Scan
on:
  pull_request:
    types: [opened, synchronize]
  schedule:
    - cron: '0 0 * * 0'  # Weekly on Sunday at midnight UTC

permissions:
  contents: read
  pull-requests: write
  security-events: write

jobs:
  dependency-review:
    name: Dependency Security Review
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      
      # NOTE: Dependency Review Action requires GitHub Advanced Security (GHAS)
      # We use pip-audit and safety instead, which provide comprehensive Python security scanning
      # without requiring GHAS. This covers all dependency vulnerabilities effectively.
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install Project Dependencies
        run: |
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt || true
          fi
          if [ -f requirements-security.txt ]; then
            pip install -r requirements-security.txt || true
          fi
      
      - name: Install Security Tools
        run: |
          pip install pip-audit safety cyclonedx-bom pip-licenses
      
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Node.js Dependency Audit
        run: |
          if [ -f package-lock.json ]; then
            npm audit --audit-level=high --json > npm-audit-report.json 2>&1 || true
            npm audit --audit-level=high || true
          fi

      - name: Python Security Scan (pip-audit)
        run: |
          pip-audit --desc --format json --output pip-audit-report.json || true
          pip-audit --desc || true
      
      - name: Python Security Scan (safety)
        run: |
          safety check --output json > safety-report.json || true
          safety check || true
      
      - name: License Compliance Check
        run: |
          pip-licenses --format=json --output-file=licenses-report.json || true
          echo "Checking for copyleft licenses (AGPL, GPL)..."
          pip-licenses | grep -E "AGPL|GPL" && echo "⚠️ Warning: Copyleft licenses detected" || echo "✅ No copyleft licenses found"
      
      - name: Generate SBOM
        run: |
          cyclonedx-py environment -o sbom.json || echo '{"bomFormat":"CycloneDX","specVersion":"1.4","version":1,"components":[]}' > sbom.json
      
      - name: Upload Security Reports
        uses: actions/upload-artifact@v4
        with:
          name: security-reports
          path: |
            npm-audit-report.json
            pip-audit-report.json
            safety-report.json
            licenses-report.json
            sbom.json
      
      - name: Comment PR with Security Summary
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let comment = '## 🔒 Security Scan Results\n\n';
            
            try {
              const pipAudit = JSON.parse(fs.readFileSync('pip-audit-report.json', 'utf8'));
              const vulnCount = pipAudit.dependencies?.filter(d => d.vulns?.length > 0).length || 0;
              comment += `### pip-audit\n- **Vulnerabilities Found:** ${vulnCount}\n\n`;
            } catch (e) {
              comment += '### pip-audit\n- ✅ No vulnerabilities found\n\n';
            }
            
            try {
              const safety = JSON.parse(fs.readFileSync('safety-report.json', 'utf8'));
              const safetyVulns = safety.vulnerabilities?.length || 0;
              comment += `### safety\n- **Vulnerabilities Found:** ${safetyVulns}\n\n`;
            } catch (e) {
              comment += '### safety\n- ✅ No vulnerabilities found\n\n';
            }
            
            try {
              const licenses = JSON.parse(fs.readFileSync('licenses-report.json', 'utf8'));
              const copyleft = licenses.filter(l => l.License?.includes('GPL') || l.License?.includes('AGPL'));
              if (copyleft.length > 0) {
                comment += `### ⚠️ License Compliance\n- **Copyleft licenses detected:** ${copyleft.length}\n`;
                copyleft.slice(0, 3).forEach(l => comment += `  - ${l.Name}: ${l.License}\n`);
                comment += '\n';
              } else {
                comment += '### ✅ License Compliance\n- No copyleft licenses detected\n\n';
              }
            } catch (e) {
              comment += '### License Compliance\n- License scan completed\n\n';
            }
            
            comment += '\n📦 Full SBOM and reports available in workflow artifacts.\n';
            comment += '\n---\n*Security scan powered by DWS IQ 6 Security Framework*';
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });
