name: Claude PR Review

on:
  pull_request:
    types: [opened, ready_for_review]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    name: Claude PR Review
    runs-on: ubuntu-latest
    timeout-minutes: 5
    # Skip drafts and bot PRs
    if: |
      !github.event.pull_request.draft &&
      github.actor != 'github-actions[bot]' &&
      github.actor != 'copilot[bot]'

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Install Claude Code CLI
        run: npm install -g @anthropic-ai/claude-code

      - name: Generate PR diff
        id: diff
        run: |
          git fetch origin ${{ github.base_ref }} --depth=50

          # Get diff, excluding lock files and binaries
          git diff origin/${{ github.base_ref }}...HEAD -- \
            '*.ts' '*.tsx' '*.js' '*.jsx' '*.py' '*.yml' '*.yaml' '*.json' '*.md' '*.sh' \
            ':!package-lock.json' ':!*.lock' ':!*.min.js' ':!*.min.css' \
            | head -c 60000 > /tmp/pr-diff.txt

          echo "diff_size=$(wc -c < /tmp/pr-diff.txt)" >> "$GITHUB_OUTPUT"

      - name: Run Claude Review and post comment
        if: steps.diff.outputs.diff_size != '0'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GH_TOKEN: ${{ github.token }}
        run: |
          if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
            echo "Skipping Claude review — ANTHROPIC_API_KEY not configured"
            exit 0
          fi

          DIFF=$(cat /tmp/pr-diff.txt)

          claude -p "Review this PR diff for security issues, code quality, and DWS6 standard compliance. Be concise. Focus on: 1) Security (hardcoded secrets, XSS, injection) 2) Code quality (types, error handling) 3) DWS standard compliance. Diff: $DIFF" \
            --allowedTools "Read" \
            --output-format json \
            > review-output.json 2>&1 || true

          cat review-output.json

          REVIEW=$(jq -r '.result // "Review completed with no output"' review-output.json 2>/dev/null || echo "Review completed — see workflow logs for details")

          gh pr comment ${{ github.event.pull_request.number }} --body "## Claude Code Auto-Review

          $REVIEW

          ---
          *Auto-generated by Claude Code auto-enable-mode*"
