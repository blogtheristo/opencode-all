# Copilot Coding Agent - Environment Setup Steps
# This file tells GitHub Copilot coding agent how to set up the dev environment
# when it works on issues or PRs autonomously.
# Docs: https://docs.github.com/en/copilot/using-github-copilot/using-copilot-coding-agent

name: "Copilot Coding Agent Setup"

steps:
  # 1. Install Node.js dependencies (required before TypeScript build)
  - name: Install Node.js dependencies
    run: npm install

  # 2. Install Python dependencies (for Firehorse automation scripts)
  - name: Install Python dependencies
    run: |
      pip install ruff bandit safety 2>/dev/null || true
      if [ -f requirements.txt ]; then pip install -r requirements.txt 2>/dev/null || true; fi

  # 3. Build TypeScript to verify compilation
  - name: Build TypeScript
    run: npm run build 2>/dev/null || true
