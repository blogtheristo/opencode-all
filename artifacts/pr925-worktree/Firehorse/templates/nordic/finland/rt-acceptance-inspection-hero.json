{
  "$schema": "../../template_config.schema.json",
  "templateId": "FI-RT-ACCEPTANCE-HERO-V1",
  "templateName": "Vastaanottotarkastus ja Luovutus",
  "templateVersion": "1.0",
  "heroDocument": true,
  "demoReady": true,
  "criticalDocument": true,
  
  "standard": {
    "type": "RT Card",
    "number": "RT 16-10660",
    "title": "Tarkastusasiakirjat ja vastaanotto",
    "year": 2019,
    "region": "Nordic",
    "country": "FI",
    "critical": true,
    "finnishStandards": [
      "RT 16-10660 (Tarkastusasiakirjat)",
      "RYL 2010 (Laatuvaatimukset)",
      "NS 3420 (Kuntoarvio)",
      "MRL 153 § (Loppukatselmus)"
    ]
  },
  
  "metadata": {
    "description": "BIM-integroitu vastaanottotarkastus. 360° kuvat, videot, AI-pohjainen puutelista. RYL 2010 automaattitarkistus.",
    "category": "Quality Management",
    "subcategory": "Acceptance Inspection",
    "languages": ["fi", "sv", "en"],
    "carbonReportingEnabled": false,
    "bimEnabled": true,
    "mobileOptimized": true,
    "aiEnabled": true,
    "tags": [
      "Vastaanottotarkastus",
      "Luovutus",
      "BIM",
      "IFC",
      "RYL 2010",
      "360° kuvat",
      "AI",
      "Hero Document"
    ]
  },
  
  "heroFeatures": {
    "title": "Construction Heroes -ominaisuudet",
    "description": "Nämä 5 ominaisuutta tekevät Firehorse-tarkastuksesta paremman kuin kilpailijoilla",
    "features": [
      {
        "id": "hero-1",
        "name": "IFC-Linkitys BIM-Malliin",
        "description": "Jokainen havainto linkitetty suoraan IFC-malliin. Klikkaa mallia → näe havainnot.",
        "icon": "📐",
        "competitorComparison": "Kilpailijat: Erilliset dokumentit, ei BIM-integraatiota"
      },
      {
        "id": "hero-2",
        "name": "360° Panoraamakuvat",
        "description": "Täysi 360° dokumentointi jokaisesta tilasta. VR-valmis.",
        "icon": "📸",
        "competitorComparison": "Kilpailijat: Tavalliset kuvat, rajattu näkökulma"
      },
      {
        "id": "hero-3",
        "name": "Video-Dokumentointi",
        "description": "4K-videot puutteista. Aikaleima ja GPS automaattisesti.",
        "icon": "🎥",
        "competitorComparison": "Kilpailijat: Vain kuvat, ei videota"
      },
      {
        "id": "hero-4",
        "name": "AI-Pohjainen Puutelista",
        "description": "AI tunnistaa puutteet automaattisesti kuvista. 95% tarkkuus.",
        "icon": "✅",
        "competitorComparison": "Kilpailijat: Manuaalinen kirjaus, virhealtis"
      },
      {
        "id": "hero-5",
        "name": "RYL 2010 Automaattitarkistus",
        "description": "Automaattinen vertailu RYL-vaatimuksiin. Instant-raportti.",
        "icon": "📊",
        "competitorComparison": "Kilpailijat: Manuaalinen RYL-tarkistus"
      }
    ]
  },
  
  "dataSources": {
    "supabase": {
      "tables": [
        "projects",
        "inspections",
        "defects",
        "bim_models",
        "inspection_photos"
      ]
    },
    "api": {
      "dwsIQ": {
        "enabled": true,
        "endpoints": [
          "/api/projects/{projectId}",
          "/api/inspections/{projectId}"
        ]
      },
      "bimPlatform": {
        "enabled": true,
        "provider": "IFC",
        "version": "IFC 4.3"
      },
      "aiService": {
        "enabled": true,
        "provider": "Azure Computer Vision",
        "models": ["defect-detection", "quality-assessment"]
      }
    }
  },
  
  "branding": {
    "allowCustomLogo": true,
    "allowCustomColors": true,
    "colorScheme": {
      "primary": "#1e293b",
      "secondary": "#10b981",
      "accent": "#3b82f6",
      "warning": "#f59e0b",
      "danger": "#ef4444",
      "success": "#10b981"
    }
  },
  
  "sections": [
    {
      "sectionId": "0",
      "sectionName": "Tarkastuksen Perustiedot",
      "required": true,
      "order": 1,
      "fields": [
        {
          "fieldId": "0.1",
          "fieldName": "inspectionDate",
          "label": "Tarkastuspäivä",
          "type": "date",
          "required": true,
          "defaultValue": "TODAY"
        },
        {
          "fieldId": "0.2",
          "fieldName": "projectCode",
          "label": "Projektikoodi",
          "type": "text",
          "required": true,
          "pattern": "^[A-Z]{2}-[A-Z0-9]{4}-[0-9]{4}$",
          "dataSource": "project.code"
        },
        {
          "fieldId": "0.3",
          "fieldName": "projectName",
          "label": "Kohteen nimi",
          "type": "text",
          "required": true,
          "dataSource": "project.name"
        },
        {
          "fieldId": "0.4",
          "fieldName": "inspectionType",
          "label": "Tarkastuksen tyyppi",
          "type": "select",
          "options": [
            "Aloituskokous",
            "Rakennusaikainen tarkastus",
            "Itselleluovutus",
            "Vastaanottotarkastus",
            "Loppukatselmus",
            "Takuutarkastus"
          ],
          "required": true
        },
        {
          "fieldId": "0.5",
          "fieldName": "ifcModelLink",
          "label": "IFC-mallin linkki",
          "type": "text",
          "format": "uri",
          "required": false,
          "heroFeature": "hero-1",
          "dataSource": "bim_model.ifc_url",
          "helpText": "Linkki BIM-malliin (IFC 4.3)"
        }
      ]
    },
    {
      "sectionId": "1",
      "sectionName": "Osallistujat",
      "required": true,
      "order": 2,
      "fields": [
        {
          "fieldId": "1.1",
          "fieldName": "participants",
          "label": "Tarkastukseen osallistujat",
          "type": "table",
          "required": true,
          "columns": [
            {"name": "name", "label": "Nimi", "type": "text"},
            {"name": "role", "label": "Rooli", "type": "text"},
            {"name": "company", "label": "Yritys", "type": "text"},
            {"name": "email", "label": "Sähköposti", "type": "text"},
            {"name": "signature", "label": "Allekirjoitus", "type": "signature"}
          ]
        }
      ]
    },
    {
      "sectionId": "2",
      "sectionName": "Tarkastettavat Kohteet",
      "required": true,
      "order": 3,
      "heroSection": true,
      "fields": [
        {
          "fieldId": "2.1",
          "fieldName": "inspectionAreas",
          "label": "Tarkastettavat alueet",
          "type": "table",
          "required": true,
          "heroFeature": "hero-1",
          "bimLinked": true,
          "columns": [
            {"name": "area", "label": "Alue", "type": "text"},
            {"name": "ifcGuid", "label": "IFC GUID", "type": "text"},
            {"name": "status", "label": "Tila", "type": "select", "options": ["Hyväksytty", "Huomautuksia", "Hylätty"]},
            {"name": "notes", "label": "Huomiot", "type": "text"}
          ],
          "ifcIntegration": {
            "enabled": true,
            "autoPopulate": true,
            "clickToNavigate": true
          }
        },
        {
          "fieldId": "2.2",
          "fieldName": "panoramaPhotos",
          "label": "360° Panoraamakuvat",
          "type": "image",
          "multiple": true,
          "required": false,
          "heroFeature": "hero-2",
          "panorama360": true,
          "vrReady": true,
          "gpsTagging": true,
          "ifcLinked": true,
          "maxFiles": 100,
          "acceptedFormats": ["jpg", "jpeg", "equirectangular"],
          "metadata": {
            "capture360": true,
            "captureGPS": true,
            "captureTimestamp": true,
            "linkToIFC": true
          },
          "helpText": "360° kuvat jokaisesta tilasta - VR-valmis"
        },
        {
          "fieldId": "2.3",
          "fieldName": "inspectionVideos",
          "label": "Tarkastusvideot",
          "type": "file",
          "multiple": true,
          "required": false,
          "heroFeature": "hero-3",
          "maxFiles": 50,
          "maxFileSize": "500MB",
          "acceptedFormats": ["mp4", "mov", "avi"],
          "resolution": "4K",
          "metadata": {
            "captureGPS": true,
            "captureTimestamp": true,
            "linkToIFC": true
          },
          "helpText": "4K-videot puutteista ja havainnoista"
        }
      ]
    },
    {
      "sectionId": "3",
      "sectionName": "Puutteet ja Havainnot",
      "required": true,
      "order": 4,
      "heroSection": true,
      "aiEnabled": true,
      "fields": [
        {
          "fieldId": "3.1",
          "fieldName": "defects",
          "label": "Havaitut puutteet",
          "type": "table",
          "required": true,
          "heroFeature": "hero-4",
          "aiDetection": true,
          "columns": [
            {"name": "id", "label": "Tunnus", "type": "text", "autoGenerate": true},
            {"name": "location", "label": "Sijainti", "type": "text"},
            {"name": "ifcGuid", "label": "IFC GUID", "type": "text"},
            {"name": "category", "label": "Kategoria", "type": "select", "options": ["Rakenteellinen", "Pintakäsittely", "Sähkö", "LVI", "Muu"]},
            {"name": "severity", "label": "Vakavuus", "type": "select", "options": ["Kriittinen", "Merkittävä", "Vähäinen"]},
            {"name": "description", "label": "Kuvaus", "type": "text"},
            {"name": "photo", "label": "Kuva", "type": "image"},
            {"name": "aiDetected", "label": "AI-tunnistus", "type": "boolean"},
            {"name": "aiConfidence", "label": "AI-varmuus %", "type": "number"},
            {"name": "responsible", "label": "Vastuuhenkilö", "type": "text"},
            {"name": "deadline", "label": "Korjaus mennessä", "type": "date"},
            {"name": "status", "label": "Tila", "type": "select", "options": ["Avoin", "Työn alla", "Korjattu", "Hyväksytty"]}
          ],
          "aiFeatures": {
            "autoDetection": true,
            "confidenceThreshold": 0.85,
            "categories": ["cracks", "water-damage", "paint-defects", "alignment-issues"],
            "autoPopulate": true
          },
          "sortable": true,
          "filterable": true,
          "exportable": true
        },
        {
          "fieldId": "3.2",
          "fieldName": "defectSummary",
          "label": "Puutteiden yhteenveto",
          "type": "table",
          "required": true,
          "autoCalculate": true,
          "columns": [
            {"name": "category", "label": "Kategoria", "type": "text"},
            {"name": "critical", "label": "Kriittinen", "type": "number"},
            {"name": "major", "label": "Merkittävä", "type": "number"},
            {"name": "minor", "label": "Vähäinen", "type": "number"},
            {"name": "total", "label": "Yhteensä", "type": "number"}
          ],
          "visualization": {
            "type": "bar-chart",
            "showPercentages": true
          }
        }
      ]
    },
    {
      "sectionId": "4",
      "sectionName": "RYL 2010 Tarkistus",
      "required": true,
      "order": 5,
      "heroSection": true,
      "autoValidation": true,
      "fields": [
        {
          "fieldId": "4.1",
          "fieldName": "rylCompliance",
          "label": "RYL 2010 -yhteensopivuus",
          "type": "table",
          "required": true,
          "heroFeature": "hero-5",
          "autoValidation": true,
          "columns": [
            {"name": "rylSection", "label": "RYL-kohta", "type": "text"},
            {"name": "requirement", "label": "Vaatimus", "type": "text"},
            {"name": "measured", "label": "Mitattu", "type": "number"},
            {"name": "tolerance", "label": "Toleranssi", "type": "text"},
            {"name": "compliant", "label": "Yhteensopiva", "type": "boolean"},
            {"name": "deviation", "label": "Poikkeama", "type": "number"}
          ],
          "rylStandards": [
            "RYL 2010 § 31 (Betonityöt)",
            "RYL 2010 § 42 (Rappaustyöt)",
            "RYL 2010 § 43 (Laatoitustyöt)",
            "RYL 2010 § 44 (Maalaustyöt)"
          ],
          "autoValidation": {
            "enabled": true,
            "checkTolerance": true,
            "flagDeviations": true
          }
        },
        {
          "fieldId": "4.2",
          "fieldName": "rylComplianceScore",
          "label": "RYL-yhteensopivuusprosentti",
          "type": "number",
          "unit": "%",
          "required": true,
          "autoCalculate": true,
          "calculation": "(compliantItems / totalItems) * 100",
          "visualization": {
            "type": "gauge",
            "colorRanges": [
              {"min": 0, "max": 70, "color": "#ef4444", "label": "Ei hyväksyttävä"},
              {"min": 70, "max": 90, "color": "#f59e0b", "label": "Tyydyttävä"},
              {"min": 90, "max": 100, "color": "#10b981", "label": "Erinomainen"}
            ]
          }
        }
      ]
    },
    {
      "sectionId": "5",
      "sectionName": "Laadunvarmistus",
      "required": true,
      "order": 6,
      "fields": [
        {
          "fieldId": "5.1",
          "fieldName": "qualityDocuments",
          "label": "Laatudokumentit",
          "type": "table",
          "required": true,
          "columns": [
            {"name": "document", "label": "Dokumentti", "type": "text"},
            {"name": "status", "label": "Tila", "type": "select", "options": ["Toimitettu", "Puuttuu", "Hyväksytty"]},
            {"name": "date", "label": "Päivämäärä", "type": "date"},
            {"name": "link", "label": "Linkki", "type": "text"}
          ]
        },
        {
          "fieldId": "5.2",
          "fieldName": "testResults",
          "label": "Testaus- ja mittaustulokset",
          "type": "table",
          "required": false,
          "columns": [
            {"name": "test", "label": "Testi", "type": "text"},
            {"name": "result", "label": "Tulos", "type": "text"},
            {"name": "requirement", "label": "Vaatimus", "type": "text"},
            {"name": "passed", "label": "Hyväksytty", "type": "boolean"}
          ]
        }
      ]
    },
    {
      "sectionId": "6",
      "sectionName": "Yhteenveto ja Päätös",
      "required": true,
      "order": 7,
      "fields": [
        {
          "fieldId": "6.1",
          "fieldName": "overallAssessment",
          "label": "Kokonaisarvio",
          "type": "select",
          "options": [
            "Hyväksytty ilman huomautuksia",
            "Hyväksytty huomautuksin",
            "Hylätty - korjaukset vaadittavat"
          ],
          "required": true
        },
        {
          "fieldId": "6.2",
          "fieldName": "summary",
          "label": "Yhteenveto",
          "type": "textarea",
          "required": true,
          "rows": 10
        },
        {
          "fieldId": "6.3",
          "fieldName": "nextSteps",
          "label": "Seuraavat toimenpiteet",
          "type": "textarea",
          "required": true,
          "rows": 5
        },
        {
          "fieldId": "6.4",
          "fieldName": "handoverDate",
          "label": "Luovutuspäivä",
          "type": "date",
          "required": false
        }
      ]
    },
    {
      "sectionId": "7",
      "sectionName": "Allekirjoitukset",
      "required": true,
      "order": 8,
      "fields": [
        {
          "fieldId": "7.1",
          "fieldName": "signatures",
          "label": "Allekirjoitukset",
          "type": "table",
          "required": true,
          "columns": [
            {"name": "name", "label": "Nimi", "type": "text"},
            {"name": "role", "label": "Rooli", "type": "text"},
            {"name": "signature", "label": "Allekirjoitus", "type": "signature"},
            {"name": "date", "label": "Päivämäärä", "type": "date"}
          ],
          "digital": true,
          "legallyBinding": true
        }
      ]
    }
  ],
  
  "outputFormats": ["PDF", "DOCX", "HTML", "JSON", "IFC-BCF"],
  
  "automation": {
    "enabled": true,
    "aiDetection": true,
    "rylValidation": true,
    "ifcIntegration": true
  },
  
  "integration": {
    "dwsIQ6Dashboard": true,
    "supabase": true,
    "bimPlatforms": ["Revit", "ArchiCAD", "Tekla", "Solibri"],
    "aiServices": ["Azure Computer Vision", "AWS Rekognition"],
    "vrPlatforms": ["Oculus", "HTC Vive"]
  },
  
  "mobileSettings": {
    "optimized": true,
    "offlineMode": true,
    "panorama360Capture": true,
    "videoCapture": true,
    "gpsTagging": true,
    "ifcViewer": true
  },
  
  "demoSettings": {
    "mockDataEnabled": true,
    "sampleInspection": {
      "projectCode": "FI-BUILD-2024",
      "projectName": "Helsingin Asuinkerrostalo",
      "inspectionType": "Vastaanottotarkastus",
      "defectsFound": 12,
      "rylCompliance": 94,
      "overallAssessment": "Hyväksytty huomautuksin"
    }
  }
}
