      {
        "id": "hero-5",
        "name": "NCC-tyyppinen Projektikoodi",
        "description": "Kansainvälinen projektitunniste. Toimii kaikissa maissa. Portfolio-raportointi.",
        "icon": "🏗️",
        "competitorComparison": "Kilpailijat: Kansalliset koodit, ei portfolio-näkymää"
      }
    ]
  },
  
  "dataSources": {
    "supabase": {
      "tables": [
        "projects",
        "carbon_factors",
        "project_carbon",
        "carbon_budget",
        "carbon_reports"
      ],
      "views": [
        "v_project_carbon_summary",
        "v_carbon_budget_status"
      ]
    },
