  "sections": [
    {
      "sectionId": "0",
      "sectionName": "Kansilehti",
      "required": true,
      "order": 1,
      "rtReference": "RT 16-11224 § 3.1",
      "fields": [
        {
          "fieldId": "0.1",
          "fieldName": "reportTitle",
          "label": "Raportin otsikko",
          "labelFi": "Hiilijalanjälkiraportti EN 15978",
          "labelSv": "Koldioxidavtrycksrapport EN 15978",
          "labelEn": "Carbon Footprint Report EN 15978",
          "type": "text",
          "required": true,
          "defaultValue": "Hiilijalanjälkiraportti EN 15978",
          "validation": {
            "minLength": 10,
            "maxLength": 200
          }
        },
        {
          "fieldId": "0.2",
          "fieldName": "projectCode",
          "label": "Projektikoodi (NCC-tyyli)",
          "labelFi": "Projektikoodi",
          "type": "text",
          "required": true,
          "heroFeature": "hero-5",
          "pattern": "^[A-Z]{2}-[A-Z0-9]{4}-[0-9]{4}$",
          "example": "FI-OFFICE-2024",
          "helpText": "Kansainvälinen projektitunniste (maa-tyyppi-vuosi)",
          "dataSource": "project.code",
          "validation": {
            "pattern": "^[A-Z]{2}-[A-Z0-9]{4}-[0-9]{4}$",
            "custom": "validateProjectCode"
          }
        },
        {
          "fieldId": "0.3",
          "fieldName": "projectName",
          "label": "Projektin nimi",
          "type": "text",
          "required": true,
          "dataSource": "project.name"
        },
        {
          "fieldId": "0.4",
          "fieldName": "reportDate",
          "label": "Raportointipäivä",
          "type": "date",
          "required": true,
          "defaultValue": "TODAY",
          "dataSource": "report.date"
        },
        {
          "fieldId": "0.5",
          "fieldName": "reportVersion",
          "label": "Versio",
          "type": "text",
          "required": true,
          "defaultValue": "1.0",
          "rtReference": "RT 16-11224 § 3.2 (Versiohistoria)"
        },
        {
          "fieldId": "0.6",
          "fieldName": "companyLogo",
          "label": "Yrityksen logo",
          "type": "image",
          "required": false,
          "dataSource": "branding.logo"
        }
      ]
    },
    {
      "sectionId": "1",
      "sectionName": "Tiivistelmä",
      "required": true,
      "order": 2,
      "rtReference": "RT 16-11224 § 4.1",
      "heroSection": true,
      "fields": [
        {
          "fieldId": "1.1",
          "fieldName": "totalCarbonFootprint",
          "label": "Kokonaishiilijalanjälki",
          "labelFi": "Kokonaishiilijalanjälki (elinkaari A-C)",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "heroFeature": "hero-1",
          "dataSource": "carbon_budget.current_carbon",
          "visualization": {
            "type": "gauge",
            "min": 0,
            "max": "carbon_budget.target_carbon",
            "colorRanges": [
              {"min": 0, "max": 70, "color": "#10b981", "label": "Erinomainen"},
              {"min": 70, "max": 90, "color": "#f59e0b", "label": "Hyvä"},
              {"min": 90, "max": 100, "color": "#ef4444", "label": "Kriittinen"}
            ]
          }
        },
        {
          "fieldId": "1.2",
          "fieldName": "carbonIntensity",
          "label": "Hiili-intensiteetti",
          "labelFi": "Hiili-intensiteetti (kg CO2-eq/m²)",
          "type": "number",
          "unit": "kg CO2-eq/m²",
          "required": true,
          "heroFeature": "hero-1",
          "dataSource": "carbon_budget.current_intensity",
          "benchmark": {
            "excellent": 350,
            "good": 450,
            "acceptable": 550,
            "poor": 650
          },
          "visualization": {
            "type": "comparison",
            "showBenchmark": true,
            "showIndustryAverage": true
          }
        },
        {
          "fieldId": "1.3",
          "fieldName": "budgetStatus",
          "label": "Hiilibudjetin tila",
          "labelFi": "Hiilibudjetin tila",
          "type": "select",
          "options": ["Tavoitteessa", "Riskissä", "Ylitetty", "Optimoitu"],
          "required": true,
          "heroFeature": "hero-2",
          "dataSource": "carbon_budget.budget_status",
          "alertThreshold": 90,
          "visualization": {
            "type": "status-badge",
            "colorMapping": {
              "Tavoitteessa": "#10b981",
              "Riskissä": "#f59e0b",
              "Ylitetty": "#ef4444",
              "Optimoitu": "#3b82f6"
            }
          }
        },
        {
          "fieldId": "1.4",
          "fieldName": "budgetUtilization",
          "label": "Budjetin käyttöaste",
          "labelFi": "Budjetin käyttöaste (%)",
          "type": "number",
          "unit": "%",
          "required": true,
          "heroFeature": "hero-2",
          "dataSource": "carbon_budget.budget_utilization_percentage",
          "calculation": "(current_carbon / target_carbon) * 100",
          "alertCondition": ">= 90",
          "visualization": {
            "type": "progress-bar",
            "showAlert": true,
            "alertThreshold": 90
          }
        },
        {
          "fieldId": "1.5",
          "fieldName": "fitFor55Status",
          "label": "Fit for 55 -yhteensopivuus",
          "labelFi": "Fit for 55 -yhteensopivuus",
          "labelEn": "Fit for 55 Compliance",
          "type": "select",
          "options": ["Yhteensopiva", "Osittain yhteensopiva", "Ei yhteensopiva"],
          "required": true,
          "heroFeature": "hero-3",
          "dataSource": "carbon_budget.fit_for_55_compliant",
          "euTaxonomy": true,
          "csrdReporting": true,
          "visualization": {
            "type": "compliance-badge",
            "showEUFlag": true
          }
        },
        {
          "fieldId": "1.6",
          "fieldName": "auditTrailLink",
          "label": "Audit Trail -linkki",
          "labelFi": "Jäljitettävyyslinkki",
          "type": "text",
          "format": "uri",
          "required": false,
          "heroFeature": "hero-4",
          "dataSource": "report.audit_trail_url",
          "helpText": "Linkki täydelliseen audit trailiin - jokainen luku jäljitettävissä",
          "blockchainReady": true
        }
      ]
