    {
      "sectionId": "3",
      "sectionName": "Elinkaaren Päästöt (EN 15978)",
      "required": true,
      "order": 4,
      "enReference": "EN 15978:2011 § 7",
      "heroSection": true,
      "subsections": [
        {
          "subsectionId": "3.1",
          "subsectionName": "A1-A3: Tuotevaihe",
          "enReference": "EN 15978 § 7.2.1",
          "fields": [
            {
              "fieldId": "3.1.1",
              "fieldName": "carbonA1A3",
              "label": "Tuotevaiheen päästöt (A1-A3)",
              "labelFi": "Tuotevaihe: Raaka-aineet, kuljetus, valmistus",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": true,
              "dataSource": "v_project_carbon_summary.carbon_a1a3",
              "calculation": "SUM(project_carbon WHERE life_cycle_stage IN ('A1','A2','A3','A1-A3'))",
              "visualization": {
                "type": "bar-chart",
                "showPercentage": true
              }
            },
            {
              "fieldId": "3.1.2",
              "fieldName": "materialsBreakdown",
              "label": "Materiaalien erittely",
              "type": "table",
              "required": true,
              "dataSource": "project_carbon.life_cycle_stage=A1-A3",
              "columns": [
                {"name": "material", "label": "Materiaali", "type": "text"},
                {"name": "quantity", "label": "Määrä", "type": "number"},
                {"name": "unit", "label": "Yksikkö", "type": "text"},
                {"name": "carbonFactor", "label": "Päästökerroin", "type": "number", "unit": "kg CO2-eq/yks"},
                {"name": "totalEmission", "label": "Kokonaispäästö", "type": "number", "unit": "kg CO2-eq"}
