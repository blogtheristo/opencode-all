      {
        "id": "hero-4",
        "name": "Audit Trail -linkki",
        "description": "Jokainen luku jäljitettävissä alkuperäiseen dataan. Blockchain-valmius.",
        "icon": "🔗",
        "competitorComparison": "Kilpailijat: Ei jäljitettävyyttä, epäluotettava data"
