{
  "templateId": "EN15978-FULL-REPORT-V1",
  "templateName": "EN 15978 Full Life Cycle Assessment Report",
  "templateVersion": "1.0",
  "standard": {
    "type": "EN 15978",
    "title": "Sustainability of construction works - Assessment of environmental performance of buildings - Calculation method",
    "year": 2011,
    "region": "Pan-European",
    "critical": true,
    "fitFor55": true
  },
  "metadata": {
    "description": "Complete EN 15978 life cycle assessment report for building carbon footprint",
    "category": "Environmental",
    "subcategory": "Carbon Assessment",
    "languages": ["en", "fi", "sv", "no", "da", "de"],
    "carbonReportingEnabled": true,
    "bimEnabled": true
  },
  "sections": [
    {
      "sectionId": "1",
      "sectionName": "Executive Summary",
      "required": true,
      "fields": [
        {
          "fieldId": "1.1",
          "fieldName": "projectName",
          "label": "Project Name",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.name"
        },
        {
          "fieldId": "1.2",
          "fieldName": "projectLocation",
          "label": "Project Location",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.location"
        },
        {
          "fieldId": "1.3",
          "fieldName": "totalCarbonFootprint",
          "label": "Total Life Cycle Carbon Footprint",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "dataSource": "supabase.carbon_budget.current_carbon"
        },
        {
          "fieldId": "1.4",
          "fieldName": "carbonIntensity",
          "label": "Carbon Intensity",
          "type": "number",
          "unit": "kg CO2-eq/m²",
          "required": true,
          "dataSource": "supabase.carbon_budget.current_intensity"
        },
        {
          "fieldId": "1.5",
          "fieldName": "complianceStatus",
          "label": "Fit for 55 Compliance Status",
          "type": "select",
          "options": ["Compliant", "At Risk", "Non-Compliant"],
          "required": true,
          "dataSource": "supabase.carbon_budget.fit_for_55_compliant"
        }
      ]
    },
    {
      "sectionId": "2",
      "sectionName": "Project Information",
      "required": true,
      "fields": [
        {
          "fieldId": "2.1",
          "fieldName": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.id"
        },
        {
          "fieldId": "2.2",
          "fieldName": "buildingType",
          "label": "Building Type",
          "type": "select",
          "options": ["Office", "Residential", "Industrial", "Mixed Use", "Infrastructure"],
          "required": true
        },
        {
          "fieldId": "2.3",
          "fieldName": "grossFloorArea",
          "label": "Gross Floor Area",
          "type": "number",
          "unit": "m²",
          "required": true,
          "dataSource": "supabase.carbon_budget.gross_floor_area"
        },
        {
          "fieldId": "2.4",
          "fieldName": "referenceStudyPeriod",
          "label": "Reference Study Period",
          "type": "number",
          "unit": "years",
          "required": true,
          "defaultValue": 50
        },
        {
          "fieldId": "2.5",
          "fieldName": "functionalEquivalent",
          "label": "Functional Equivalent",
          "type": "text",
          "required": true,
          "helpText": "e.g., 1 m² of gross floor area over 50 years"
        }
      ]
    },
    {
      "sectionId": "3",
      "sectionName": "System Boundaries",
      "required": true,
      "fields": [
        {
          "fieldId": "3.1",
          "fieldName": "lifeCycleStagesIncluded",
          "label": "Life Cycle Stages Included",
          "type": "multiselect",
          "options": ["A1-A3", "A4", "A5", "B1", "B2", "B3", "B4", "B5", "B6", "B7", "C1", "C2", "C3", "C4", "D"],
          "required": true,
          "defaultValue": ["A1-A3", "A4", "A5", "B6", "C1-C4"]
        },
        {
          "fieldId": "3.2",
          "fieldName": "systemBoundaryDescription",
          "label": "System Boundary Description",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "sectionId": "4",
      "sectionName": "Life Cycle Inventory (LCI)",
      "required": true,
      "subsections": [
        {
          "subsectionId": "4.1",
          "subsectionName": "Product Stage (A1-A3)",
          "fields": [
            {
              "fieldId": "4.1.1",
              "fieldName": "materialQuantities",
              "label": "Material Quantities",
              "type": "table",
              "required": true,
              "dataSource": "supabase.project_carbon.life_cycle_stage=A1-A3",
              "columns": [
                {"name": "material", "label": "Material", "type": "text"},
                {"name": "quantity", "label": "Quantity", "type": "number"},
                {"name": "unit", "label": "Unit", "type": "text"},
                {"name": "carbonFactor", "label": "Carbon Factor (kg CO2-eq/unit)", "type": "number"},
                {"name": "totalEmission", "label": "Total Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.1.2",
              "fieldName": "totalA1A3",
              "label": "Total Product Stage Emissions",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": true,
              "calculation": "SUM(materialQuantities.totalEmission)",
              "dataSource": "supabase.v_project_carbon_summary.carbon_a1a3"
            }
          ]
        },
        {
          "subsectionId": "4.2",
          "subsectionName": "Construction Process Stage (A4-A5)",
          "fields": [
            {
              "fieldId": "4.2.1",
              "fieldName": "transportData",
              "label": "Transport to Site (A4)",
              "type": "table",
              "required": true,
              "dataSource": "supabase.project_carbon.life_cycle_stage=A4",
              "columns": [
                {"name": "material", "label": "Material", "type": "text"},
                {"name": "weight", "label": "Weight (kg)", "type": "number"},
                {"name": "distance", "label": "Distance (km)", "type": "number"},
                {"name": "transportMode", "label": "Transport Mode", "type": "text"},
                {"name": "emission", "label": "Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.2.2",
              "fieldName": "constructionProcesses",
              "label": "Construction Processes (A5)",
              "type": "table",
              "required": true,
              "dataSource": "supabase.project_carbon.life_cycle_stage=A5",
              "columns": [
                {"name": "activity", "label": "Activity", "type": "text"},
                {"name": "energyUse", "label": "Energy Use (kWh)", "type": "number"},
                {"name": "emission", "label": "Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.2.3",
              "fieldName": "totalA4A5",
              "label": "Total Construction Stage Emissions",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": true,
              "calculation": "SUM(transportData.emission) + SUM(constructionProcesses.emission)",
              "dataSource": "supabase.v_project_carbon_summary.carbon_a4 + carbon_a5"
            }
          ]
        },
        {
          "subsectionId": "4.3",
          "subsectionName": "Use Stage (B1-B7)",
          "fields": [
            {
              "fieldId": "4.3.1",
              "fieldName": "operationalEnergy",
              "label": "Operational Energy Use (B6)",
              "type": "table",
              "required": true,
              "dataSource": "supabase.project_carbon.life_cycle_stage=B6",
              "columns": [
                {"name": "energyType", "label": "Energy Type", "type": "text"},
                {"name": "annualConsumption", "label": "Annual Consumption (kWh)", "type": "number"},
                {"name": "studyPeriod", "label": "Study Period (years)", "type": "number"},
                {"name": "totalEmission", "label": "Total Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.3.2",
              "fieldName": "maintenanceActivities",
              "label": "Maintenance Activities (B2-B5)",
              "type": "table",
              "required": false,
              "dataSource": "supabase.project_carbon.life_cycle_stage LIKE 'B%'",
              "columns": [
                {"name": "activity", "label": "Activity", "type": "text"},
                {"name": "frequency", "label": "Frequency (years)", "type": "number"},
                {"name": "emission", "label": "Emission per cycle (kg CO2-eq)", "type": "number"},
                {"name": "totalEmission", "label": "Total Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.3.3",
              "fieldName": "totalB1B7",
              "label": "Total Use Stage Emissions",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": true,
              "dataSource": "supabase.v_project_carbon_summary.carbon_b1b7"
            }
          ]
        },
        {
          "subsectionId": "4.4",
          "subsectionName": "End of Life Stage (C1-C4)",
          "fields": [
            {
              "fieldId": "4.4.1",
              "fieldName": "endOfLifeScenarios",
              "label": "End of Life Scenarios",
              "type": "table",
              "required": true,
              "dataSource": "supabase.project_carbon.life_cycle_stage LIKE 'C%'",
              "columns": [
                {"name": "material", "label": "Material", "type": "text"},
                {"name": "quantity", "label": "Quantity", "type": "number"},
                {"name": "scenario", "label": "Scenario", "type": "text"},
                {"name": "emission", "label": "Emission (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.4.2",
              "fieldName": "totalC1C4",
              "label": "Total End of Life Emissions",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": true,
              "dataSource": "supabase.v_project_carbon_summary.carbon_c1c4"
            }
          ]
        },
        {
          "subsectionId": "4.5",
          "subsectionName": "Benefits Beyond System Boundary (D)",
          "fields": [
            {
              "fieldId": "4.5.1",
              "fieldName": "recyclingBenefits",
              "label": "Recycling and Reuse Benefits",
              "type": "table",
              "required": false,
              "dataSource": "supabase.project_carbon.life_cycle_stage=D",
              "columns": [
                {"name": "material", "label": "Material", "type": "text"},
                {"name": "quantity", "label": "Quantity", "type": "number"},
                {"name": "benefit", "label": "Benefit (kg CO2-eq)", "type": "number"}
              ]
            },
            {
              "fieldId": "4.5.2",
              "fieldName": "totalD",
              "label": "Total Benefits (Module D)",
              "type": "number",
              "unit": "kg CO2-eq",
              "required": false,
              "dataSource": "supabase.v_project_carbon_summary.carbon_d"
            }
          ]
        }
      ]
    },
    {
      "sectionId": "5",
      "sectionName": "Environmental Indicators",
      "required": true,
      "fields": [
        {
          "fieldId": "5.1",
          "fieldName": "gwp",
          "label": "Global Warming Potential (GWP)",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "dataSource": "supabase.carbon_budget.current_carbon"
        },
        {
          "fieldId": "5.2",
          "fieldName": "odp",
          "label": "Ozone Depletion Potential (ODP)",
          "type": "number",
          "unit": "kg CFC11-eq",
          "required": false
        },
        {
          "fieldId": "5.3",
          "fieldName": "ap",
          "label": "Acidification Potential (AP)",
          "type": "number",
          "unit": "kg SO2-eq",
          "required": false
        },
        {
          "fieldId": "5.4",
          "fieldName": "ep",
          "label": "Eutrophication Potential (EP)",
          "type": "number",
          "unit": "kg PO4-eq",
          "required": false
        },
        {
          "fieldId": "5.5",
          "fieldName": "pocp",
          "label": "Photochemical Ozone Creation Potential (POCP)",
          "type": "number",
          "unit": "kg C2H4-eq",
          "required": false
        },
        {
          "fieldId": "5.6",
          "fieldName": "adp",
          "label": "Abiotic Depletion Potential (ADP)",
          "type": "number",
          "unit": "kg Sb-eq",
          "required": false
        },
        {
          "fieldId": "5.7",
          "fieldName": "pe",
          "label": "Primary Energy (PE)",
          "type": "number",
          "unit": "MJ",
          "required": false
        }
      ]
    },
    {
      "sectionId": "6",
      "sectionName": "Results by Life Cycle Stage",
      "required": true,
      "fields": [
        {
          "fieldId": "6.1",
          "fieldName": "lifeCycleBreakdown",
          "label": "Carbon Emissions by Life Cycle Stage",
          "type": "table",
          "required": true,
          "dataSource": "supabase.v_project_carbon_summary",
          "columns": [
            {"name": "stage", "label": "Life Cycle Stage", "type": "text"},
            {"name": "emission", "label": "Emission (kg CO2-eq)", "type": "number"},
            {"name": "percentage", "label": "Percentage (%)", "type": "number"}
          ],
          "rows": [
            {"stage": "A1-A3: Product Stage", "dataField": "carbon_a1a3"},
            {"stage": "A4: Transport to Site", "dataField": "carbon_a4"},
            {"stage": "A5: Construction Process", "dataField": "carbon_a5"},
            {"stage": "B1-B7: Use Stage", "dataField": "carbon_b1b7"},
            {"stage": "C1-C4: End of Life", "dataField": "carbon_c1c4"},
            {"stage": "D: Benefits", "dataField": "carbon_d"},
            {"stage": "Total (A-C)", "dataField": "total_carbon"}
          ]
        },
        {
          "fieldId": "6.2",
          "fieldName": "lifeCycleChart",
          "label": "Life Cycle Stage Chart",
          "type": "chart",
          "chartType": "bar",
          "required": true,
          "dataSource": "lifeCycleBreakdown"
        }
      ]
    },
    {
      "sectionId": "7",
      "sectionName": "Carbon Footprint Summary",
      "required": true,
      "fields": [
        {
          "fieldId": "7.1",
          "fieldName": "embodiedCarbon",
          "label": "Embodied Carbon (A1-A5 + C1-C4)",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "calculation": "totalA1A3 + totalA4A5 + totalC1C4"
        },
        {
          "fieldId": "7.2",
          "fieldName": "operationalCarbon",
          "label": "Operational Carbon (B6-B7)",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "calculation": "totalB1B7"
        },
        {
          "fieldId": "7.3",
          "fieldName": "lifeCycleCarbon",
          "label": "Total Life Cycle Carbon",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": true,
          "calculation": "embodiedCarbon + operationalCarbon",
          "dataSource": "supabase.carbon_budget.current_carbon"
        },
        {
          "fieldId": "7.4",
          "fieldName": "carbonIntensity",
          "label": "Carbon Intensity",
          "type": "number",
          "unit": "kg CO2-eq/m²",
          "required": true,
          "calculation": "lifeCycleCarbon / grossFloorArea",
          "dataSource": "supabase.carbon_budget.current_intensity"
        }
      ]
    },
    {
      "sectionId": "8",
      "sectionName": "Fit for 55 Compliance",
      "required": true,
      "fields": [
        {
          "fieldId": "8.1",
          "fieldName": "euTaxonomyAlignment",
          "label": "EU Taxonomy Alignment",
          "type": "select",
          "options": ["Aligned", "Partially Aligned", "Not Aligned"],
          "required": true,
          "dataSource": "supabase.carbon_budget.eu_taxonomy_aligned"
        },
        {
          "fieldId": "8.2",
          "fieldName": "dnshAssessment",
          "label": "Do No Significant Harm (DNSH) Assessment",
          "type": "select",
          "options": ["Passed", "Failed", "Not Assessed"],
          "required": true
        },
        {
          "fieldId": "8.3",
          "fieldName": "minimumSafeguards",
          "label": "Minimum Safeguards Compliance",
          "type": "select",
          "options": ["Compliant", "Non-Compliant"],
          "required": true
        },
        {
          "fieldId": "8.4",
          "fieldName": "technicalScreeningCriteria",
          "label": "Technical Screening Criteria Met",
          "type": "multiselect",
          "options": [
            "Climate Change Mitigation",
            "Climate Change Adaptation",
            "Sustainable Use of Water",
            "Transition to Circular Economy",
            "Pollution Prevention",
            "Biodiversity Protection"
          ],
          "required": true
        }
      ]
    },
    {
      "sectionId": "9",
      "sectionName": "Data Quality Assessment",
      "required": true,
      "fields": [
        {
          "fieldId": "9.1",
          "fieldName": "dataSources",
          "label": "Data Sources",
          "type": "textarea",
          "required": true,
          "helpText": "List all data sources used (EPDs, databases, measurements)"
        },
        {
          "fieldId": "9.2",
          "fieldName": "dataQualityRating",
          "label": "Overall Data Quality Rating",
          "type": "select",
          "options": ["High", "Medium", "Low"],
          "required": true
        },
        {
          "fieldId": "9.3",
          "fieldName": "uncertaintyAnalysis",
          "label": "Uncertainty Analysis",
          "type": "textarea",
          "required": false
        },
        {
          "fieldId": "9.4",
          "fieldName": "assumptions",
          "label": "Key Assumptions and Limitations",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "sectionId": "10",
      "sectionName": "Recommendations",
      "required": true,
      "fields": [
        {
          "fieldId": "10.1",
          "fieldName": "carbonReductionOpportunities",
          "label": "Carbon Reduction Opportunities",
          "type": "textarea",
          "required": true
        },
        {
          "fieldId": "10.2",
          "fieldName": "materialSubstitutions",
          "label": "Recommended Material Substitutions",
          "type": "table",
          "required": false,
          "columns": [
            {"name": "currentMaterial", "label": "Current Material", "type": "text"},
            {"name": "alternativeMaterial", "label": "Alternative Material", "type": "text"},
            {"name": "carbonSaving", "label": "Carbon Saving (kg CO2-eq)", "type": "number"}
          ]
        },
        {
          "fieldId": "10.3",
          "fieldName": "nextSteps",
          "label": "Next Steps",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "sectionId": "11",
      "sectionName": "Verification",
      "required": false,
      "fields": [
        {
          "fieldId": "11.1",
          "fieldName": "verified",
          "label": "Third-Party Verification",
          "type": "boolean",
          "required": false,
          "dataSource": "supabase.carbon_reports.verified"
        },
        {
          "fieldId": "11.2",
          "fieldName": "verifierName",
          "label": "Verifier Name",
          "type": "text",
          "required": false,
          "dataSource": "supabase.carbon_reports.verifier_name"
        },
        {
          "fieldId": "11.3",
          "fieldName": "verifierOrganization",
          "label": "Verifier Organization",
          "type": "text",
          "required": false,
          "dataSource": "supabase.carbon_reports.verifier_organization"
        },
        {
          "fieldId": "11.4",
          "fieldName": "verificationDate",
          "label": "Verification Date",
          "type": "date",
          "required": false,
          "dataSource": "supabase.carbon_reports.verification_date"
        }
      ]
    }
  ],
  "outputFormats": ["PDF", "DOCX", "HTML", "JSON"],
  "automation": {
    "enabled": true,
    "triggers": ["Monthly", "Phase Completion", "On Demand"],
    "alertConditions": {
      "carbonBudgetThreshold": 90,
      "highCarbonMaterials": true,
      "complianceRisk": true
    }
  },
  "integration": {
    "dwsIQ6Dashboard": true,
    "supabase": true,
    "firehorseCMS": true,
    "edgeNodes": true
  }
}
