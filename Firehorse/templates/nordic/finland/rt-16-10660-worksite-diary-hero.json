  "heroFeatures": {
    "title": "Construction Heroes -ominaisuudet",
    "description": "Nämä 5 ominaisuutta tekevät Firehorse-päiväkirjasta paremman kuin kilpailijoilla",
    "features": [
      {
        "id": "hero-1",
        "name": "Automaattinen Sää & Lämpötila",
        "description": "Edge nodes mittaavat ja tallentavat automaattisesti. Ei manuaalista kirjausta.",
        "icon": "🌡️",
        "competitorComparison": "Kilpailijat: Manuaalinen kirjaus, usein unohdetaan"
      },
      {
        "id": "hero-2",
        "name": "Automaattinen Työntekijämäärä",
        "description": "RFID-lukijat laskevat työntekijät automaattisesti. Reaaliaikainen seuranta.",
        "icon": "👷",
        "competitorComparison": "Kilpailijat: Arvio, epätarkka, ei reaaliaikaista"
      },
      {
        "id": "hero-3",
        "name": "Kuvat & Videot Suoraan Päiväkirjaan",
        "description": "Mobiilikamera → päiväkirja. GPS-koordinaatit ja aikaleima automaattisesti.",
        "icon": "📸",
        "competitorComparison": "Kilpailijat: Erilliset kuvat, ei integraatiota"
      },
      {
        "id": "hero-4",
        "name": "Digitaalinen Allekirjoitus",
        "description": "Työnjohtaja allekirjoittaa mobiilissa. Ei paperikopioita. Täydellinen audit trail.",
        "icon": "✍️",
        "competitorComparison": "Kilpailijat: Paperiallekirjoitus, skannaus, arkistointi"
      },
      {
        "id": "hero-5",
        "name": "Täydellinen Jäljitettävyys",
        "description": "Jokainen muutos tallennetaan. Kuka, milloin, mitä. Blockchain-valmius.",
        "icon": "🔗",
        "competitorComparison": "Kilpailijat: Ei muutoshistoriaa, ei jäljitettävyyttä"
      }
    ]
  },
  
  "dataSources": {
    "supabase": {
      "tables": [
        "projects",
        "worksite_diary_entries",
        "weather_data",
        "worker_attendance",
        "site_photos"
      ]
    },
    "api": {
      "dwsIQ": {
        "enabled": true,
        "endpoints": [
          "/api/projects/{projectId}",
          "/api/worksite/{projectId}/daily"
        ]
      },
      "edgeNodes": {
        "enabled": true,
        "nodeIds": ["auto-detect"],
        "dataTypes": ["weather", "temperature", "humidity", "workers", "equipment"]
      },
      "weatherAPI": {
        "enabled": true,
        "provider": "FMI (Ilmatieteen laitos)",
        "fallback": "OpenWeatherMap"
      }
    }
  },
  
  "branding": {
    "allowCustomLogo": true,
    "allowCustomColors": true,
    "defaultLogo": "https://dws6.com/assets/firehorse-logo.png",
