{
  "templateId": "FI-RT-10-11224-V1",
  "templateName": "RT 10-11224 Project Management Documentation",
  "templateVersion": "1.0",
  "standard": {
    "type": "RT Card",
    "number": "RT 10-11224",
    "title": "Project Management Documentation in Construction",
    "country": "Finland",
    "region": "Nordic",
    "classification": "Talo 2000"
  },
  "metadata": {
    "description": "Finnish RT card template for project management documentation",
    "category": "Project Management",
    "languages": ["fi", "sv", "en"],
    "carbonReportingEnabled": true
  },
  "sections": [
    {
      "sectionId": "1",
      "sectionName": "RT Card Header",
      "required": true,
      "fields": [
        {
          "fieldId": "1.1",
          "fieldName": "rtNumber",
          "label": "RT Card Number",
          "type": "text",
          "required": true,
          "defaultValue": "RT 10-11224"
        },
        {
          "fieldId": "1.2",
          "fieldName": "title",
          "label": "Document Title",
          "type": "text",
          "required": true,
          "multilingual": true
        },
        {
          "fieldId": "1.3",
          "fieldName": "version",
          "label": "Version",
          "type": "text",
          "required": true,
          "defaultValue": "1.0"
        },
        {
          "fieldId": "1.4",
          "fieldName": "date",
          "label": "Issue Date",
          "type": "date",
          "required": true
        },
        {
          "fieldId": "1.5",
          "fieldName": "classificationCode",
          "label": "Talo 2000 Classification Code",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "sectionId": "2",
      "sectionName": "Project Information",
      "required": true,
      "fields": [
        {
          "fieldId": "2.1",
          "fieldName": "projectName",
          "label": "Project Name",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.name"
        },
        {
          "fieldId": "2.2",
          "fieldName": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.id"
        },
        {
          "fieldId": "2.3",
          "fieldName": "projectLocation",
          "label": "Project Location",
          "type": "text",
          "required": true,
          "dataSource": "dws_iq.project.location"
        },
        {
          "fieldId": "2.4",
          "fieldName": "projectPhase",
          "label": "Project Phase",
          "type": "select",
          "options": ["Planning", "Design", "Construction", "Completion", "Operations"],
          "required": true,
          "dataSource": "dws_iq.project.phase"
        }
      ]
    },
    {
      "sectionId": "3",
      "sectionName": "Project Organization",
      "required": true,
      "fields": [
        {
          "fieldId": "3.1",
          "fieldName": "projectManager",
          "label": "Project Manager",
          "type": "text",
          "required": true
        },
        {
          "fieldId": "3.2",
          "fieldName": "client",
          "label": "Client",
          "type": "text",
          "required": true
        },
        {
          "fieldId": "3.3",
          "fieldName": "mainContractor",
          "label": "Main Contractor",
          "type": "text",
          "required": true
        },
        {
          "fieldId": "3.4",
          "fieldName": "projectTeam",
          "label": "Project Team",
          "type": "table",
          "required": true,
          "columns": [
            {"name": "role", "label": "Role", "type": "text"},
            {"name": "name", "label": "Name", "type": "text"},
            {"name": "organization", "label": "Organization", "type": "text"},
            {"name": "contact", "label": "Contact", "type": "text"}
          ]
        }
      ]
    },
    {
      "sectionId": "4",
      "sectionName": "Project Schedule",
      "required": true,
      "fields": [
        {
          "fieldId": "4.1",
          "fieldName": "startDate",
          "label": "Project Start Date",
          "type": "date",
          "required": true
        },
        {
          "fieldId": "4.2",
          "fieldName": "completionDate",
          "label": "Planned Completion Date",
          "type": "date",
          "required": true
        },
        {
          "fieldId": "4.3",
          "fieldName": "percentComplete",
          "label": "Percent Complete",
          "type": "number",
          "unit": "%",
          "required": true,
          "dataSource": "dws_iq.project.percentComplete"
        },
        {
          "fieldId": "4.4",
          "fieldName": "spi",
          "label": "Schedule Performance Index (SPI)",
          "type": "number",
          "required": true,
          "dataSource": "dws_iq.project.spi"
        }
      ]
    },
    {
      "sectionId": "5",
      "sectionName": "Project Budget",
      "required": true,
      "fields": [
        {
          "fieldId": "5.1",
          "fieldName": "totalBudget",
          "label": "Total Budget",
          "type": "number",
          "unit": "EUR",
          "required": true,
          "dataSource": "dws_iq.project.budget"
        },
        {
          "fieldId": "5.2",
          "fieldName": "actualCost",
          "label": "Actual Cost to Date",
          "type": "number",
          "unit": "EUR",
          "required": true,
          "dataSource": "dws_iq.project.actualCost"
        },
        {
          "fieldId": "5.3",
          "fieldName": "cpi",
          "label": "Cost Performance Index (CPI)",
          "type": "number",
          "required": true,
          "dataSource": "dws_iq.project.cpi"
        }
      ]
    },
    {
      "sectionId": "6",
      "sectionName": "Quality Management (RYL 2010)",
      "required": true,
      "fields": [
        {
          "fieldId": "6.1",
          "fieldName": "qualityLevel",
          "label": "Quality Level",
          "type": "select",
          "options": ["Level 1", "Level 2", "Level 3"],
          "required": true
        },
        {
          "fieldId": "6.2",
          "fieldName": "qualityStatus",
          "label": "Quality Status (RAG)",
          "type": "select",
          "options": ["Green", "Amber", "Red"],
          "required": true,
          "dataSource": "dws_iq.project.qualityRag"
        },
        {
          "fieldId": "6.3",
          "fieldName": "qualityIssues",
          "label": "Quality Issues",
          "type": "table",
          "required": false,
          "dataSource": "dws_iq.alerts.type=quality",
          "columns": [
            {"name": "issue", "label": "Issue", "type": "text"},
            {"name": "severity", "label": "Severity", "type": "text"},
            {"name": "status", "label": "Status", "type": "text"}
          ]
        }
      ]
    },
    {
      "sectionId": "7",
      "sectionName": "Safety Management",
      "required": true,
      "fields": [
        {
          "fieldId": "7.1",
          "fieldName": "safetyStatus",
          "label": "Safety Status (RAG)",
          "type": "select",
          "options": ["Green", "Amber", "Red"],
          "required": true,
          "dataSource": "dws_iq.project.safetyRag"
        },
        {
          "fieldId": "7.2",
          "fieldName": "safetyIncidents",
          "label": "Safety Incidents",
          "type": "table",
          "required": false,
          "dataSource": "dws_iq.alerts.type=safety",
          "columns": [
            {"name": "incident", "label": "Incident", "type": "text"},
            {"name": "date", "label": "Date", "type": "date"},
            {"name": "severity", "label": "Severity", "type": "text"}
          ]
        }
      ]
    },
    {
      "sectionId": "8",
      "sectionName": "Environmental Management (EN 15978)",
      "required": true,
      "fields": [
        {
          "fieldId": "8.1",
          "fieldName": "carbonTracking",
          "label": "Carbon Tracking Enabled",
          "type": "boolean",
          "required": true,
          "defaultValue": true
        },
        {
          "fieldId": "8.2",
          "fieldName": "currentCarbon",
          "label": "Current Carbon Footprint",
          "type": "number",
          "unit": "kg CO2-eq",
          "required": false,
          "dataSource": "supabase.carbon_budget.current_carbon"
        },
        {
          "fieldId": "8.3",
          "fieldName": "carbonIntensity",
          "label": "Carbon Intensity",
          "type": "number",
          "unit": "kg CO2-eq/m²",
          "required": false,
          "dataSource": "supabase.carbon_budget.current_intensity"
        },
        {
          "fieldId": "8.4",
          "fieldName": "carbonBudgetStatus",
          "label": "Carbon Budget Status",
          "type": "select",
          "options": ["On Track", "At Risk", "Over Budget"],
          "required": false,
          "dataSource": "supabase.carbon_budget.budget_status"
        }
      ]
    },
    {
      "sectionId": "9",
      "sectionName": "Related RT Cards",
      "required": false,
      "fields": [
        {
          "fieldId": "9.1",
          "fieldName": "relatedCards",
          "label": "Related RT Cards",
          "type": "table",
          "required": false,
          "columns": [
            {"name": "rtNumber", "label": "RT Number", "type": "text"},
            {"name": "title", "label": "Title", "type": "text"},
            {"name": "relevance", "label": "Relevance", "type": "text"}
          ],
          "defaultRows": [
            {"rtNumber": "RT 13-11223", "title": "Quality Management", "relevance": "Quality procedures"},
            {"rtNumber": "RT 16-11224", "title": "Environmental Management", "relevance": "Environmental compliance"}
          ]
        }
      ]
    },
    {
      "sectionId": "10",
      "sectionName": "Approval Signatures",
      "required": true,
      "fields": [
        {
          "fieldId": "10.1",
          "fieldName": "preparedBy",
          "label": "Prepared By",
          "type": "text",
          "required": true
        },
        {
          "fieldId": "10.2",
          "fieldName": "preparedDate",
          "label": "Prepared Date",
          "type": "date",
          "required": true
        },
        {
          "fieldId": "10.3",
          "fieldName": "approvedBy",
          "label": "Approved By",
          "type": "text",
          "required": true
        },
        {
          "fieldId": "10.4",
          "fieldName": "approvedDate",
          "label": "Approved Date",
          "type": "date",
          "required": true
        }
      ]
    }
  ],
  "outputFormats": ["PDF", "DOCX"],
  "automation": {
    "enabled": true,
    "triggers": ["Monthly", "Phase Completion"],
    "recipients": ["project-manager@client.fi"]
  },
  "integration": {
    "dwsIQ6Dashboard": true,
    "supabase": true
  }
}
