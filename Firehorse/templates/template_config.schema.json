{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dws6.com/schemas/firehorse/template-config.schema.json",
  "title": "Firehorse Template Configuration Schema",
  "description": "JSON schema for European construction document template configurations",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "templateId",
    "templateName",
    "standard",
    "metadata",
    "sections"
  ],
  "properties": {
    "templateId": {
      "type": "string",
      "description": "Unique template identifier",
      "pattern": "^[A-Z]{2}-[A-Z0-9]+-[A-Z0-9]+-V[0-9]+$",
      "examples": ["EN15978-FULL-REPORT-V1", "FI-RT-10-11224-V1"]
    },
    "templateName": {
      "type": "string",
      "description": "Human-readable template name",
      "minLength": 5,
      "maxLength": 200
    },
    "templateVersion": {
      "type": "string",
      "description": "Template version",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "1.0"
    },
    "standard": {
      "type": "object",
      "description": "Construction standard information",
      "required": ["type", "region"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Standard type",
          "enum": [
            "EN 15978",
            "RT Card",
            "InfraRYL",
            "RYL",
            "AMA Anläggning",
            "AMA Hus",
            "MBR",
            "NS 3420",
            "NS 8405",
            "NS 8406",
            "NS 8407",
            "FDV",
            "BR",
            "BEK",
            "CAB",
            "BSAB",
            "NCS",
            "IFC",
            "BCF",
            "VOB/A",
            "VOB/B",
            "VOB/C",
            "DIN 18205",
            "DIN 276",
            "DIN 277",
            "ÖNORM A 2063",
            "ÖNORM B",
            "LM.VM",
            "SIA 102",
            "SIA 112",
            "SIA 118",
            "eBKP-H",
            "NEN 2574",
            "RAW Bestek",
            "STABU",
            "NBN B",
            "Bestek",
            "ISO 19650",
            "ISO 9001",
            "ISO 14001",
            "ISO 45001",
            "CPR",
            "Eurocode",
            "CSRD",
            "LEED",
            "BREEAM",
            "DGNB",
            "Custom"
          ]
        },
        "number": {
          "type": "string",
          "description": "Standard number or code",
          "examples": ["RT 10-11224", "NS 8405", "EN 15978:2011"]
        },
        "title": {
          "type": "string",
          "description": "Full standard title"
        },
        "year": {
          "type": "integer",
          "description": "Standard publication year",
          "minimum": 1990,
          "maximum": 2030
        },
        "region": {
          "type": "string",
          "description": "Geographic region",
          "enum": ["Nordic", "Central Europe", "Pan-European", "Global"]
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code",
          "pattern": "^[A-Z]{2}$",
          "examples": ["FI", "SE", "NO", "DK", "DE", "AT", "CH", "NL", "BE"]
        },
        "critical": {
          "type": "boolean",
          "description": "Whether this standard is critical for compliance",
          "default": false
        },
        "fitFor55": {
          "type": "boolean",
          "description": "Whether this standard relates to Fit for 55 compliance",
          "default": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Template metadata",
      "required": ["description", "category"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Template description",
          "minLength": 10,
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "description": "Template category",
          "enum": [
            "Project Management",
            "Technical Specifications",
            "Contract Documentation",
            "Quality Management",
            "Safety Management",
            "Environmental",
            "Carbon Assessment",
            "Cost Planning",
            "BIM Documentation",
            "Operations & Maintenance",
            "Compliance Reporting"
          ]
        },
        "subcategory": {
          "type": "string",
          "description": "Template subcategory"
        },
        "languages": {
          "type": "array",
          "description": "Supported languages",
          "items": {
            "type": "string",
            "enum": ["en", "fi", "sv", "no", "da", "de", "fr", "nl", "it", "es"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["en"]
        },
        "carbonReportingEnabled": {
          "type": "boolean",
          "description": "Whether carbon reporting is enabled",
          "default": false
        },
        "bimEnabled": {
          "type": "boolean",
          "description": "Whether BIM integration is enabled",
          "default": false
        },
        "tags": {
          "type": "array",
          "description": "Template tags for search",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dataSources": {
      "type": "object",
      "description": "Data source configurations",
      "properties": {
        "supabase": {
          "type": "object",
          "description": "Supabase data sources",
          "properties": {
            "tables": {
              "type": "array",
              "description": "Required Supabase tables",
              "items": {
                "type": "string",
                "enum": [
                  "projects",
                  "alerts",
                  "kpis",
                  "carbon_factors",
                  "project_carbon",
                  "carbon_budget",
                  "carbon_reports",
                  "materials",
                  "deliveries",
                  "energy_data"
                ]
              }
            },
            "views": {
              "type": "array",
              "description": "Required Supabase views",
              "items": {
                "type": "string",
                "enum": [
                  "v_project_carbon_summary",
                  "v_carbon_budget_status"
                ]
              }
            }
          }
        },
        "api": {
          "type": "object",
          "description": "External API endpoints",
          "properties": {
            "dwsIQ": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "endpoints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri-reference"
                  }
                }
              }
            },
            "edgeNodes": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "nodeIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "description": "Branding and customization options",
      "properties": {
        "allowCustomLogo": {
          "type": "boolean",
          "description": "Allow customer logo",
          "default": true
        },
        "allowCustomColors": {
          "type": "boolean",
          "description": "Allow custom color scheme",
          "default": true
        },
        "allowCustomFonts": {
          "type": "boolean",
          "description": "Allow custom fonts",
          "default": false
        },
        "defaultLogo": {
          "type": "string",
          "description": "Default logo URL",
          "format": "uri"
        },
        "colorScheme": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "default": "#1e293b"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "default": "#3b82f6"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "default": "#10b981"
            }
          }
        },
        "fonts": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "default": "Arial"
            },
            "body": {
              "type": "string",
              "default": "Arial"
            },
            "monospace": {
              "type": "string",
              "default": "Courier New"
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Template sections",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sectionId", "sectionName", "required", "fields"],
        "properties": {
          "sectionId": {
            "type": "string",
            "description": "Section identifier",
            "pattern": "^[0-9]+$"
          },
          "sectionName": {
            "type": "string",
            "description": "Section name",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "description": "Whether section is required"
          },
          "order": {
            "type": "integer",
            "description": "Section display order",
            "minimum": 1
          },
          "fields": {
            "type": "array",
            "description": "Section fields",
            "items": {
              "type": "object",
              "required": ["fieldId", "fieldName", "label", "type"],
              "properties": {
                "fieldId": {
                  "type": "string",
                  "description": "Field identifier"
                },
                "fieldName": {
                  "type": "string",
                  "description": "Field name (camelCase)",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "label": {
                  "type": "string",
                  "description": "Field label"
                },
                "type": {
                  "type": "string",
                  "description": "Field type",
                  "enum": [
                    "text",
                    "textarea",
                    "number",
                    "date",
                    "datetime",
                    "boolean",
                    "select",
                    "multiselect",
                    "table",
                    "chart",
                    "signature",
                    "file",
                    "image"
                  ]
                },
                "required": {
                  "type": "boolean",
                  "description": "Whether field is required",
                  "default": false
                },
                "unit": {
                  "type": "string",
                  "description": "Unit of measurement",
                  "examples": ["EUR", "kg CO2-eq", "m²", "%", "days"]
                },
                "defaultValue": {
                  "description": "Default field value"
                },
                "options": {
                  "type": "array",
                  "description": "Options for select/multiselect fields",
                  "items": {
                    "type": "string"
                  }
                },
                "dataSource": {
                  "type": "string",
                  "description": "Data source path (e.g., 'dws_iq.project.name', 'supabase.carbon_budget.current_carbon')"
                },
                "calculation": {
                  "type": "string",
                  "description": "Calculation formula for computed fields"
                },
                "validation": {
                  "type": "object",
                  "description": "Validation rules",
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "minLength": {
                      "type": "integer"
                    },
                    "maxLength": {
                      "type": "integer"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "custom": {
                      "type": "string",
                      "description": "Custom validation function name"
                    }
                  }
                },
                "multilingual": {
                  "type": "boolean",
                  "description": "Whether field supports multiple languages",
                  "default": false
                },
                "helpText": {
                  "type": "string",
                  "description": "Help text for field"
                }
              }
            }
          },
          "subsections": {
            "type": "array",
            "description": "Nested subsections",
            "items": {
              "$ref": "#/properties/sections/items"
            }
          }
        }
      }
    },
    "outputFormats": {
      "type": "array",
      "description": "Supported output formats",
      "items": {
        "type": "string",
        "enum": ["PDF", "DOCX", "XLSX", "PPTX", "HTML", "JSON", "XML"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["PDF"]
    },
    "automation": {
      "type": "object",
      "description": "Automation configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether automation is enabled",
          "default": false
        },
        "triggers": {
          "type": "array",
          "description": "Automation triggers",
          "items": {
            "type": "string",
            "enum": [
              "Daily",
              "Weekly",
              "Monthly",
              "Quarterly",
              "Phase Completion",
              "Milestone",
              "Threshold Alert",
              "On Demand"
            ]
          }
        },
        "alertConditions": {
          "type": "object",
          "description": "Alert conditions",
          "properties": {
            "carbonBudgetThreshold": {
              "type": "number",
              "description": "Carbon budget threshold percentage",
              "minimum": 0,
              "maximum": 100,
              "default": 90
            },
            "highCarbonMaterials": {
              "type": "boolean",
              "description": "Alert on high carbon materials",
              "default": false
            },
            "complianceRisk": {
              "type": "boolean",
              "description": "Alert on compliance risks",
              "default": false
            },
            "qualityIssues": {
              "type": "boolean",
              "description": "Alert on quality issues",
              "default": false
            },
            "safetyIncidents": {
              "type": "boolean",
              "description": "Alert on safety incidents",
              "default": false
            }
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "description": "Integration settings",
      "properties": {
        "dwsIQ6Dashboard": {
          "type": "boolean",
          "description": "DWS IQ 6 dashboard integration",
          "default": true
        },
        "supabase": {
          "type": "boolean",
          "description": "Supabase integration",
          "default": true
        },
        "firehorseCMS": {
          "type": "boolean",
          "description": "Firehorse CMS integration",
          "default": false
        },
        "edgeNodes": {
          "type": "boolean",
          "description": "Edge nodes integration",
          "default": false
        },
        "sapPM": {
          "type": "boolean",
          "description": "SAP PM integration",
          "default": false
        },
        "bimPlatforms": {
          "type": "array",
          "description": "BIM platform integrations",
          "items": {
            "type": "string",
            "enum": ["Revit", "ArchiCAD", "Tekla", "Solibri", "BIM360"]
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "description": "Compliance validation rules",
      "properties": {
        "requiredFields": {
          "type": "array",
          "description": "Fields required for compliance",
          "items": {
            "type": "string"
          }
        },
        "validationRules": {
          "type": "array",
          "description": "Validation rules",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["error", "warning", "info"]
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "certificationRequired": {
          "type": "boolean",
          "description": "Whether third-party certification is required",
          "default": false
        }
      }
    }
  }
}
