  "paths": {
    "chemicals:carbon": {
      "situation": {
        "fi": "Emme tiedä tuotantoerien hiilijalanjälkeä",
        "en": "We don't know the carbon footprint of production batches"
      },
      "causes": [
        {
          "id": "energy-not-linked",
          "fi": "Tuotantodata ei yhdisty energiaan",
          "en": "Production data is not linked to energy",
          "prior": 0.43
        },
        {
          "id": "material-missing",
          "fi": "Materiaalidataa puuttuu",
          "en": "Material data is missing",
          "prior": 0.28
        },
        {
          "id": "supplier-missing",
          "fi": "Toimittajien päästötiedot puuttuvat",
          "en": "Supplier emission data is missing",
          "prior": 0.15
        },
        {
          "id": "no-model",
          "fi": "Laskentamalli puuttuu",
          "en": "No calculation model",
          "prior": 0.09
        },
        {
          "id": "wrong-place",
          "fi": "Raportointi on väärässä paikassa",
          "en": "Reporting sits in the wrong place",
          "prior": 0.05
        }
      ],
      "questions": [
        {
          "id": "batch-id",
          "fi": "Voidaanko yksittäinen erä tunnistaa järjestelmistänne?",
          "en": "Can a single batch be identified in your systems?",
          "yesRulesOut": ["wrong-place"],
          "noBoosts": ["energy-not-linked", "no-model"]
        },
        {
          "id": "material-data",
          "fi": "Onko materiaalitiedot saatavilla erätasolla?",
          "en": "Is material data available per batch?",
          "yesRulesOut": ["material-missing"],
          "noBoosts": ["material-missing"]
        },
        {
          "id": "energy-link",
          "fi": "Onko energiankulutus yhdistettävissä erään?",
          "en": "Can energy consumption be attributed to a batch?",
          "yesRulesOut": ["energy-not-linked"],
          "noBoosts": ["energy-not-linked"]
        },
        {
          "id": "model",
          "fi": "Onko päästölaskentamalli määritelty?",
          "en": "Is an emission calculation model defined?",
          "yesRulesOut": ["no-model"],
          "noBoosts": ["no-model"]
        }
      ],
      "path": {
        "fi": [
          "Yhdistä MES-data ja energia",
          "Määritä erätason hiilijalanjälkimalli",
          "Täydennä puuttuvat toimittajatiedot",
          "Automatisoi laskenta"
        ],
        "en": [
          "Link MES data and energy",
          "Define a batch-level footprint model",
          "Complete missing supplier data",
          "Automate the calculation"
        ]
      },
      "goal": {
        "fi": "Tuotantoerien hiilijalanjälki todennettavaksi",
        "en": "Batch carbon footprint made verifiable"
      },
      "weeks": 8,
      "solutions": [
        {
          "sku": "DWS-CLIMATE-001",
          "name": "Climate Intelligence",
          "why": {
            "fi": "Laskee erätason hiilijalanjäljen ja tuottaa tarkastettavan tuloksen.",
            "en": "Computes batch-level footprint with an auditable result."
          },
          "start": true
        },
        {
          "sku": "ED-T1",
          "name": "Emissions Data",
          "why": {
            "fi": "Tuo energian ja päästökertoimet erätason laskentaan.",
            "en": "Brings energy and emission factors into batch calculation."
          }
        },
        {
          "sku": "MO-T1",
          "name": "Material Oracle",
          "why": {
            "fi": "Täydentää materiaalidatan ja toimittajien päästötiedot.",
            "en": "Completes material and supplier emission data."
          }
        },
        {
          "sku": "CMP-T1",
          "name": "Compliance Agent",
          "why": {
            "fi": "Kytkee tuloksen CSRD/CBAM-raportointiin oikeassa paikassa.",
            "en": "Connects the result to CSRD/CBAM reporting in the right place."
          }
        }
      ]
    },
    "construction:reporting": {
      "situation": {
        "fi": "Raportointi vie liikaa aikaa",
        "en": "Reporting takes too much time"
      },
      "causes": [
        {
          "id": "manual-collection",
          "fi": "Tiedot kerätään käsin työmailta",
          "en": "Data is collected manually from sites",
          "prior": 0.4
        },
        {
          "id": "systems-split",
          "fi": "Tieto on hajallaan useissa järjestelmissä",
          "en": "Data is split across systems",
          "prior": 0.3
        },
        {
          "id": "no-template",
          "fi": "Raporttipohja ja vaatimus eivät kohtaa",
          "en": "Template and requirement don't match",
          "prior": 0.2
        },
        {
          "id": "people",
          "fi": "Raportointi on yhden henkilön varassa",
          "en": "Reporting depends on one person",
          "prior": 0.1
        }
      ],
      "questions": [
        {
          "id": "digital-site",
          "fi": "Kirjataanko työmaatiedot digitaalisesti (ei paperi/WhatsApp)?",
          "en": "Is site data recorded digitally (not paper/WhatsApp)?",
          "yesRulesOut": ["manual-collection"],
          "noBoosts": ["manual-collection"]
        },
        {
          "id": "one-source",
          "fi": "Onko yksi paikka, josta raportin tiedot haetaan?",
          "en": "Is there one place the report data comes from?",
          "yesRulesOut": ["systems-split"],
          "noBoosts": ["systems-split"]
        },
        {
          "id": "known-req",
          "fi": "Tiedättekö tarkalleen, mitä raportin vastaanottaja vaatii?",
          "en": "Do you know exactly what the recipient requires?",
          "yesRulesOut": ["no-template"],
          "noBoosts": ["no-template"]
        }
      ],
      "path": {
        "fi": [
          "Yhdistä työmaakirjaukset yhteen lähteeseen",
          "Määritä raporttipohja vaatimuksen mukaan",
          "Automatisoi kooste ja jakelu",
          "Mittaa: 8 h → 30 min"
        ],
        "en": [
          "Bring site records into one source",
          "Define the template to the requirement",
          "Automate compilation and distribution",
          "Measure: 8 h → 30 min"
        ]
      },
      "goal": {
        "fi": "Viikkoraportointi 8 tunnista 30 minuuttiin",
        "en": "Weekly reporting from 8 hours to 30 minutes"
      },
      "weeks": 6,
      "solutions": [
        {
          "sku": "SS-T1",
          "name": "SiteSense",
          "why": {
            "fi": "Kerää työmaan tilanteen ja turvallisuuden ilman käsin raportointia.",
            "en": "Captures site status and safety without manual reporting."
          },
          "start": true
        },
        {
          "sku": "FH-RPT-001",
          "name": "DWS IQ Report",
          "why": {
            "fi": "Tuottaa koosteen suoraan lähdetiedosta vaatimuksen muotoon.",
            "en": "Compiles the report from source data into the required form."
          }
        },
        {
          "sku": "SG-T1",
          "name": "Schedule Genius",
          "why": {
            "fi": "Pitää aikataulun ja poikkeamat samassa näkymässä.",
            "en": "Keeps schedule and deviations in one view."
          }
        }
      ]
    },
    "energy:reporting": {
      "situation": {
        "fi": "Päästö- ja velvoiteraportointi on jälkikäteistä",
        "en": "Emission and obligation reporting is after the fact"
      },
      "causes": [
        {
          "id": "no-live-data",
          "fi": "Tuotanto- ja päästödata ei ole reaaliaikaista",
          "en": "Production and emission data are not live",
          "prior": 0.45
        },
        {
          "id": "ets-cbam-split",
          "fi": "ETS, CBAM ja CSRD tehdään erillään",
          "en": "ETS, CBAM and CSRD are done separately",
          "prior": 0.35
        },
        {
          "id": "no-owner",
          "fi": "Kenelläkään ei ole kokonaisvastuuta",
          "en": "No one owns the whole",
          "prior": 0.2
        }
      ],
      "questions": [
        {
          "id": "live",
          "fi": "Näettekö päästöt päivä- tai tuntitasolla?",
          "en": "Do you see emissions at day or hour level?",
          "yesRulesOut": ["no-live-data"],
          "noBoosts": ["no-live-data"]
        },
        {
          "id": "one-pipeline",
          "fi": "Tuleeko ETS-, CBAM- ja CSRD-luvut samasta laskennasta?",
          "en": "Do ETS, CBAM and CSRD figures come from one calculation?",
          "yesRulesOut": ["ets-cbam-split"],
          "noBoosts": ["ets-cbam-split"]
        }
      ],
      "path": {
        "fi": [
          "Yhdistä tuotanto- ja päästödata yhteen laskentaan",
          "Johda ETS, CBAM ja CSRD samasta lähteestä",
          "Ohjaa tuotantoa päästötiedolla, ei raportin takia"
        ],
        "en": [
          "Unify production and emission data in one calculation",
          "Derive ETS, CBAM and CSRD from one source",
          "Steer production with emission data, not for the report"
        ]
      },
      "goal": {
        "fi": "Päästöt näkyvät päätöksinä, eivät raportteina",
        "en": "Emissions visible as decisions, not reports"
      },
      "weeks": 10,
      "solutions": [
        {
          "sku": "DWS-CLIMATE-001",
          "name": "Climate Intelligence",
          "why": {
            "fi": "Yksi laskenta ETS:lle, CBAM:lle ja CSRD:lle.",
            "en": "One calculation for ETS, CBAM and CSRD."
          },
          "start": true
        },
        {
          "sku": "IND-HELIOS",
          "name": "Helios (energia)",
          "why": {
            "fi": "Energiatoimialan säännöt ja kertoimet valmiina.",
            "en": "Energy-sector rules and factors ready."
          }
        },
        {
          "sku": "ED-T1",
          "name": "Emissions Data",
          "why": {
            "fi": "Reaaliaikainen päästödata laskennan pohjaksi.",
            "en": "Live emission data as the base."
          }
        }
      ]
    },
