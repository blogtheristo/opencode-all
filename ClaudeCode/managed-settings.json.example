{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "_comment": "DWS6 Claude Code managed settings template. Deploy to C:\\Program Files\\ClaudeCode\\managed-settings.json (Windows, effective 2026-03-12). See ClaudeCode/README.md",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": 1
  },
  "cleanupPeriodDays": 7,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.secret)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/credentials.json)",
      "Read(**/service-account-*.json)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git status *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)",
      "WebFetch(domain:anthropic.com)"
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "allowManagedPermissionRulesOnly": false,
  "allow_remote_sessions": true
}
