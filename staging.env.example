# DWS IQ 6 — Staging Environment Template
#
# Copy to .env on your staging host and fill in staging-specific values.
# NEVER use production credentials here. Staging uses an isolated Supabase
# project and lower-cost LLM tiers.
#
# Usage:
#   cp staging.env.example .env   # on staging host, then fill in real values
#
# Code-Version: 1.0.0
# Branch: claude/fix-v1-features-wODI5-1QXGi
# Date: 2026-04-15
# Owner: Lifetime Oy

ENV_SCHEMA_VERSION=1.1.0

# ============================================================================
# SERVER
# ============================================================================
PORT=8080
NODE_ENV=staging

# ============================================================================
# SECURITY
# ============================================================================
# Generate a separate secret — never reuse the production JWT_SECRET in staging
JWT_SECRET=staging-jwt-secret-min-32-chars-change-this
JWT_EXPIRES_IN=7d

# CORS — staging frontend URL
CORS_ORIGIN=https://staging.dws6.com,http://localhost:5173

# Rate limiting — more permissive in staging for manual testing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Admin API key for staging management
ADMIN_API_KEY=staging-admin-key-change-this

# ============================================================================
# AI / LLM
# ============================================================================
# Use cheaper/smaller models in staging to reduce cost

# Scaleway — same region, smaller model
SCW_SECRET_KEY=your-scaleway-staging-key
SCW_GENERATIVE_API_URL=https://api.scaleway.ai/v1/chat/completions
SCW_MODEL=llama-3.1-8b-instruct

# NVIDIA NIM (optional in staging)
# NIM_API_KEY=
# NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NIM_MODEL=meta/llama-3.1-8b-instruct

# Groq (US) — acceptable for staging (not production EU data)
GROQ_API_KEY=your-groq-staging-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-staging-key

# Ollama — point at staging edge device if available; else leave empty
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# ============================================================================
# DATABASE
# ============================================================================
# Staging Supabase project — SEPARATE project from production
# Create at: supabase.com → New Project → name: dws6-staging
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_KEY=your-staging-service-role-key

# Direct DB connection for migrations (staging)
DATABASE_URL=postgresql://postgres:password@db.your-staging-project.supabase.co:5432/postgres

# ============================================================================
# REDIS
# ============================================================================
# Staging Redis — separate DB index to avoid colliding with production data
# (redis://host:6379/1 = DB 1, production uses DB 0)
REDIS_URL=redis://localhost:6379/1

# ============================================================================
# EMAIL (Amazon SES — same sender domain)
# ============================================================================
# NOTE: Application-level outbound email interception is not enforced by this
# template. Configure interception at provider level if required.
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-staging-smtp-user
SMTP_PASS=your-ses-staging-smtp-password
SMTP_SECURE=false
EMAIL_FROM=risto@onelifetime.world

# ============================================================================
# NOTIFICATIONS — Slack-free defaults
# ============================================================================
# Generic HTTPS notification target. Use Teams, ntfy/Gotify, or another approved broker.
NOTIFY_WEBHOOK_URL=

# Optional WhatsApp Business Cloud API settings.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ============================================================================
# ERP INTEGRATIONS (disabled in staging — use mock responses)
# ============================================================================
ENABLE_SAP_INTEGRATION=false
ENABLE_IFS_INTEGRATION=false
ENABLE_DYNAMICS_INTEGRATION=false
ENABLE_MONITOR_INTEGRATION=false
ENABLE_VISMA_INTEGRATION=false
ENABLE_JEEVES_INTEGRATION=false

# ============================================================================
# SCHEDULED JOBS (selective — avoid noisy staging cron traffic)
# ============================================================================
ENABLE_CRON_JOBS=true
ENABLE_MORNING_BRIEFING=false
ENABLE_CONSTRUCTION_LEADS=false
ENABLE_OUTREACH_DIGEST=false
ENABLE_FIREHORSE_SCHEDULER=false
ENABLE_INVESTOR_REPORTS=false
ENABLE_ERP_SYNC=false

# ============================================================================
# STAGING-SPECIFIC FLAGS
# ============================================================================
# Verbose logging
LOG_LEVEL=debug

# Return detailed error stacks (same as development)
DETAILED_ERRORS=true

# Disable EU AI Act Article 12 audit logging in staging (prod-only compliance)
SOVEREIGNTY_AUDIT_ENABLED=false

# No DGX Spark failover in staging
HEARTBEAT_ENDPOINT=false
