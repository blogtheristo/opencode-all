# Dependencies
node_modules
npm-debug.log

# Build output (we build in Docker)
dist

# Development files
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation
*.md
!README.md
# Required at runtime by cron jobs in dws-cron container:
#   - AGENTS.md read by scripts/verify-agents-md.mjs (agents-md-freshness)
#   - CLAUDE.md read by scripts/golden-principle-check.mjs (golden-principle-scan)
!AGENTS.md
!CLAUDE.md
docs/

# Tests
**/__tests__
**/*.test.ts
**/*.spec.ts
coverage/
.nyc_output/

# Frontend (not needed for backend image)
dws6.com/
landing-pages/
Firehorse/

# MCP servers (separate deployment)
mcp-servers/
mcp-hub/

# Other unneeded directories
supabase/
AgentFoundry/
.github/

# Miscellaneous
*.log
*.tmp
.DS_Store
Thumbs.db
