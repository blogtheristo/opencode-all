{
  "_comment": "Per-site CSS selectors for competitor price extraction (Tier 2 of 3-tier chain).",
  "_updated": "2026-03-01",
  "_standard": "DWS_MARKET_RESEARCH_STANDARD.md §4.1",
  "_selector_notes": [
    "price_selector: CSS selector whose text content contains the price number.",
    "period_selector: CSS selector whose text reveals billing period (monthly/yearly/etc).",
    "currency_hint: force a currency when the page uses symbols only.",
    "price_regex: optional regex with named group (?P<price>\\d[\\d.,]*) to extract from matched text.",
    "Update selectors when sites redesign. Run: python scripts/collect_market_research.py --dry-run --competitor <Name>"
  ],
  "sites": {
    "https://zoom.us/pricing": {
      "price_selector": "[data-testid='price-amount'], .plan-price .price, .pricing__amount",
      "period_selector": "[data-testid='billing-period'], .plan-price__period",
      "currency_hint": "USD",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://workspace.google.com/pricing": {
      "price_selector": ".price-main, [data-price], .sPiWtf",
      "period_selector": ".price-period, .RM7AV",
      "currency_hint": "USD",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://www.microsoft.com/en-us/microsoft-teams/compare-microsoft-teams-options": {
      "price_selector": ".m-product-placement-item__price, [itemprop='price'], .price",
      "period_selector": ".m-product-placement-item__price-desc",
      "currency_hint": "USD",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://proton.me/pricing": {
      "price_selector": "[data-testid='price'], .price__amount, .plan-price",
      "period_selector": "[data-testid='billing-period'], .price__period",
      "currency_hint": "EUR",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://tuta.com/pricing": {
      "price_selector": ".price, [class*='price-value'], [class*='plan-price']",
      "period_selector": "[class*='period'], [class*='billing']",
      "currency_hint": "EUR",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://construction.autodesk.com/products/autodesk-build/pricing/": {
      "price_selector": "[class*='price'], [data-price]",
      "period_selector": "[class*='period'], [class*='billing']",
      "currency_hint": "USD",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://www.procore.com/pricing": {
      "price_selector": "[class*='price-amount'], [class*='plan-price']",
      "period_selector": "[class*='price-period']",
      "currency_hint": "USD",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://ecoinvent.org/ecoinvent-in-your-organisation/registration/": {
      "price_selector": "[class*='price'], table td:nth-child(2)",
      "period_selector": "[class*='period']",
      "currency_hint": "CHF",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://simapro.com/sales/": {
      "price_selector": "[class*='price'], .woocommerce-Price-amount",
      "period_selector": ".price-period, [class*='billing']",
      "currency_hint": "EUR",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://www.worldfavor.com/pricing/": {
      "price_selector": "[class*='price'], [class*='plan-amount']",
      "period_selector": "[class*='period']",
      "currency_hint": "EUR",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    },
    "https://www.positiongreen.com/en/pricing/": {
      "price_selector": "[class*='price'], [class*='cost'], [class*='amount']",
      "period_selector": "[class*='period'], [class*='billing']",
      "currency_hint": "EUR",
      "price_regex": "(?P<price>\\d[\\d.,]*)"
    }
  }
}
