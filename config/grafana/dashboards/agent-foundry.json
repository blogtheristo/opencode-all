{
  "dashboard": {
    "id": null,
    "title": "DWS IQ 6 Agent Foundry - AI Agents Dashboard",
    "tags": ["dws", "ai-agents", "agent-foundry", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Agent Health Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(agent_health_status)",
            "legendFormat": "Healthy Agents",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Total Agent Executions",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(agent_executions_total)",
            "legendFormat": "Total Executions",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Agent Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(agent_executions_total{status='success'}[5m])) / sum(rate(agent_executions_total[5m])) * 100",
            "legendFormat": "Success Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 80
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Average Execution Time",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(rate(agent_execution_duration_seconds_sum[5m]) / rate(agent_execution_duration_seconds_count[5m]))",
            "legendFormat": "Avg Duration",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "mappings": []
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Agent Execution Rate (per minute)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(agent_executions_total[5m])) * 60",
            "legendFormat": "Executions/min",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 6,
        "title": "Agent Health Status",
        "type": "table",
        "targets": [
          {
            "expr": "agent_health_status",
            "legendFormat": "{{agent_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        }
      },
      {
        "id": 7,
        "title": "Agent Execution Duration by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_execution_duration_seconds_bucket[5m])) by (le, agent_type))",
            "legendFormat": "{{agent_type}} P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(agent_execution_duration_seconds_bucket[5m])) by (le, agent_type))",
            "legendFormat": "{{agent_type}} P50",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 8,
        "title": "Agent Success vs Failure Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(agent_executions_total{status='success'}[5m]))",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "sum(rate(agent_executions_total{status='error'}[5m]))",
            "legendFormat": "Error",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        }
      },
      {
        "id": 9,
        "title": "Leads Processed by Agent",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(agent_leads_processed_total[5m])) by (agent_id)",
            "legendFormat": "{{agent_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        }
      },
      {
        "id": 10,
        "title": "Agent API Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(agent_api_requests_total[5m])) by (api_name)",
            "legendFormat": "{{api_name}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}