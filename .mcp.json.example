{
  "mcpServers": {
    "dws-agents-local": {
      "type": "url",
      "url": "http://localhost:8080/mcp"
    },
    "dws-gateway-local": {
      "type": "command",
      "command": "python",
      "args": [
        "mcp-servers/cloud-run-gateway/server.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
