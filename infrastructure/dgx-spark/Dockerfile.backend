# DWS IQ Backend — DGX Spark (ARM64)
# Runs Express server + all 16 agents + node-cron schedulers
#
# Evidence: Tool=GitHub Copilot CLI 1.0.88 Model=openai/gpt-5.6-sol Agent=copilot Date=2026-09-27
# Audit trail: git log -- infrastructure/dgx-spark/Dockerfile.backend
#
# Code-Version: 1.0.1
# Date: 2026-09-27

FROM node:24-slim AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json tsconfig.json ./

# Install dependencies. The runtime entrypoint is `npx tsx src/app.ts`, but tsx is a
# devDependency and the runtime user has no writable HOME, so npx cannot fetch it at
# start-up. Install it explicitly at the version this repo declares.
RUN npm install --omit=dev --ignore-scripts && \
    npm install --no-save --ignore-scripts "tsx@$(node -p "require('./package.json').devDependencies.tsx")" && \
    npm cache clean --force

# Copy source
COPY src/ ./src/
COPY .env.example ./.env.example

# Build TypeScript
RUN npx tsc --noEmit || true

FROM node:24-slim

WORKDIR /app

# Create non-root user
RUN groupadd -r dws && useradd -r -g dws -s /bin/false dws

# Copy built app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/src ./src
COPY --from=builder /app/tsconfig.json ./
COPY dws10.com/config/products.json ./dws10.com/config/products.json

# Create directories for logs and data
RUN mkdir -p /app/logs /app/backups && \
    chown -R dws:dws /app

USER dws

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD node -e "fetch('http://localhost:8080/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "src/app.ts"]
