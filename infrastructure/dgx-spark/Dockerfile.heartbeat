# DWS Heartbeat — Lightweight health aggregator
# Reports DGX Spark status; GitHub Actions checks this before running
#
# Code-Version: 1.0.0
# Date: 2026-03-29

FROM node:22-slim

WORKDIR /app

RUN groupadd -r dws && useradd -r -g dws -s /bin/false dws

COPY heartbeat.ts ./

RUN chown -R dws:dws /app
USER dws

EXPOSE 9999

CMD ["npx", "tsx", "heartbeat.ts"]
