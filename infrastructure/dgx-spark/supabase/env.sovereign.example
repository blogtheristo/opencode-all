# ============================================================================
# Sovereign Supabase (DGX / Scenario S2) — required .env additions
# ============================================================================
# Append these to infrastructure/dgx-spark/.env (which is git-ignored and lives
# only on the DGX host). Placeholders only — generate real values per
# SOVEREIGN_SUPABASE_SETUP.md. NEVER commit real keys.
# ============================================================================

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=postgres
# 32+ char random string. Generate: openssl rand -base64 48
POSTGRES_PASSWORD=__CHANGE_ME__

# --- JWT (signs the anon + service_role keys AND GoTrue/PostgREST tokens) ----
# 40+ char random string. Generate: openssl rand -base64 48
JWT_SECRET=__CHANGE_ME__
JWT_EXPIRY=3600

# --- API keys (JWTs signed with JWT_SECRET) ---------------------------------
# Generate both with the JWT_SECRET above — see SOVEREIGN_SUPABASE_SETUP.md
# (role "anon" and role "service_role", 10-year exp). These are what the backend
# and Kong use; the service_role key bypasses RLS, so treat it as a secret.
SUPABASE_ANON_KEY=__GENERATED_ANON_JWT__
SUPABASE_SERVICE_KEY=__GENERATED_SERVICE_ROLE_JWT__

# --- URLs -------------------------------------------------------------------
# The backend/cron/mcp-gateway reach Supabase over the internal dws-network.
# Point the app's client here (replaces the Supabase Cloud URL):
SUPABASE_URL=http://supabase-kong:8000
# Public-facing URL if the DGX exposes Supabase through its ingress (Studio,
# external tools). Leave as the internal URL for a pure air-gapped setup.
SUPABASE_PUBLIC_URL=http://supabase-kong:8000
# Where auth redirects land (the backend's own origin).
SITE_URL=http://dws-backend:8080
