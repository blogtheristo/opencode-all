# DWS Temporal Worker — DGX Spark (ARM64)
# Runs src/temporal/worker.ts: polls all six domain task queues
# (see src/temporal/task-queues.ts) against the dws-temporal server.
#
# Code-Version: 1.0.0
# Date: 2026-09-23

FROM node:24-slim

WORKDIR /app

RUN groupadd -r dws && useradd -r -g dws -s /bin/bash -m dws \
 && mkdir -p /home/dws/.npm && chown -R dws:dws /home/dws

ENV HOME=/home/dws

COPY package.json package-lock.json ./
# Full install (not --omit=dev): tsx (the CMD's runtime) is a devDependency.
RUN npm install && npm cache clean --force

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY tsconfig.json ./

RUN mkdir -p /app/logs && chown -R dws:dws /app

USER dws

CMD ["npx", "tsx", "scripts/temporal-worker.ts"]
