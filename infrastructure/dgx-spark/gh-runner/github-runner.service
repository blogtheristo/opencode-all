# Evidence: Tool=Claude Code (cloud) Agent=runner-hardening Date=2026-09-23
# Audit trail: git log -- infrastructure/dgx-spark/gh-runner/github-runner.service
#
# Hardened, ephemeral GitHub Actions runner for DGX Spark (Code-Version 2.0.0).
# One job per unit start: mint JIT config (root) -> run one job (gh-runner)
# -> wipe state (root) -> Restart. Installed to /etc/systemd/system/ by
# infrastructure/dgx-spark/setup-github-runner.sh.

[Unit]
Description=GitHub Actions Runner, hardened + ephemeral (DGX Spark)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gh-runner
Group=gh-runner
WorkingDirectory=/srv/gh-runner/runner
Environment=HOME=/srv/gh-runner/home
Environment=RUNNER_TOOL_CACHE=/srv/gh-runner/runner/_work/_tool
RuntimeDirectory=gh-runner
RuntimeDirectoryMode=0700

ExecStartPre=+/usr/local/lib/gh-runner/gh-runner-cleanup.sh
ExecStartPre=+/usr/local/lib/gh-runner/gh-runner-jitconfig.sh
ExecStart=/usr/local/lib/gh-runner/gh-runner-start.sh
ExecStopPost=+/usr/local/lib/gh-runner/gh-runner-cleanup.sh

Restart=always
RestartSec=3
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5min

# --- Privilege ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
UMask=0077

# --- Filesystem: host is read-only, /home and /root invisible ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/gh-runner/runner/_work /srv/gh-runner/runner/_diag /srv/gh-runner/home
InaccessiblePaths=-/etc/gh-runner -/var/run/docker.sock -/run/docker.sock

# --- Kernel attack surface ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @reboot @swap @raw-io @obsolete @cpu-emulation @debug
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# --- Resource caps: protect Ollama / training workloads ---
CPUQuota=800%
MemoryMax=24G
TasksMax=4096

[Install]
WantedBy=multi-user.target
