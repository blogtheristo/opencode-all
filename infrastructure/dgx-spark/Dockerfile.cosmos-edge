FROM nvcr.io/nvidia/pytorch:24.03-py3

WORKDIR /workspace

# Install required Python packages
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    pydantic==2.5.0 \
    numpy==1.24.3 \
    torch==2.3.0 \
    requests==2.31.0 \
    aiohttp==3.9.1

# Grace Blackwell compatibility
ENV CUDA_ARCH=90

EXPOSE 8000
