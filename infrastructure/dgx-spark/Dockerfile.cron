# DWS Cron Runner — DGX Spark (ARM64)
# Mirrors all GitHub Actions scheduled workflows as local cron jobs
# Primary runtime; GitHub Actions is failover only
#
# Code-Version: 1.0.0
# Date: 2026-03-29

FROM node:24-slim

WORKDIR /app

# Create non-root user
RUN groupadd -r dws && useradd -r -g dws -s /bin/false dws

# Copy package files and install
COPY package.json package-lock.json ./
RUN npm install --omit=dev --ignore-scripts && npm cache clean --force

# Copy source and scripts
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY tsconfig.json ./
COPY infrastructure/dgx-spark/cron-runner.ts ./cron-runner.ts

# Root-level docs that scheduled jobs read at runtime:
#   - agents-md-freshness reads AGENTS.md
#   - golden-principle-scan reads CLAUDE.md and other root .md files
COPY AGENTS.md ./
COPY CLAUDE.md ./

# Create state/log dirs
RUN mkdir -p /app/logs /app/state /app/backups && \
    chown -R dws:dws /app

USER dws

EXPOSE 8081

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
  CMD node -e "fetch('http://localhost:8081/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "cron-runner.ts"]
