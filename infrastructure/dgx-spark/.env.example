# DGX Spark Environment — Copy to .env and fill in values
# Code-Version: 1.0.0 | Date: 2026-03-29

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_DB_PASSWORD=your-db-password

# === AI Providers ===
# Claude (API — Designer agent, complex orchestration)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (fallback for burst capacity)
GROQ_API_KEY=gsk_...

# Google Gemini (optional)
GOOGLE_API_KEY=

# Ollama runs natively on DGX Spark — no key needed
# OLLAMA_BASE_URL is set in docker-compose.yml

# === Email (Amazon SES SMTP) ===
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your-ses-smtp-user
EMAIL_PASS=your-ses-smtp-pass
EMAIL_FROM=risto@onelifetime.world

# === JWT ===
JWT_SECRET=your-jwt-secret

# === GitHub (for heartbeat status reporting) ===
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=blogtheristo/dws6

# === Cloudflare ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# === Model Configuration ===
# Primary: Ollama local (zero cost, full speed on GB10)
# Fallback: Groq API (burst capacity)
LLM_PRIMARY=ollama
LLM_FALLBACK=groq
# MUST match OLLAMA_DEPLOYED_MODELS in src/agents/model-selector.ts,
# REQUIRED_MODELS in scripts/daily/check-ollama-models.sh, and the pulls in
# deploy.sh / Deploy-DgxSpark.ps1. llama3.3:70b + qwen2.5-coder:32b were the
# DEPRECATED pair that `deploy.sh --models-cleanup` exists to remove.
OLLAMA_MODEL=nemotron-3-super
OLLAMA_MODEL_FAST=qwen3-coder:30b

# === Cron Flags ===
ENABLE_CRON_JOBS=true
ENABLE_MORNING_BRIEFING=true
ENABLE_CONSTRUCTION_LEADS=true
ENABLE_OUTREACH_DIGEST=true
ENABLE_FIREHORSE_SCHEDULER=true
ENABLE_INVESTOR_REPORTS=true
ENABLE_ERP_SYNC=true
