# Evidence: Tool=OpenCode 1.18.21 Model=opencode/x-preview-f-free (ox-alpha) Date=2026-08-24
# Audit trail: git log -- infrastructure/dgx-spark/Dockerfile.opencode-all
FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl bash tmux \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g opencode-ai@latest

WORKDIR /repo
CMD ["node", "scripts/opencode-batch-worker.mjs", "run", "--loop", "--batch", "3"]
