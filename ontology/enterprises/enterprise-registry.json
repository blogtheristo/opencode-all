  },
  "enterprise_schema": {
    "required": ["name", "country", "nace_code", "revenue_eur", "employees", "regulatory_exposure"],
    "outreach_fields": {
      "buying_roles": "Array of R-IDs from DWS_ROLES_REGISTRY.md (e.g. R03, R07, R14)",
      "buying_stage": "AWARENESS | CONSIDERATION | DECISION | ONBOARDING | EXPANSION",
      "pain_points": "Array of industry-specific pain points mapped to DWS products",
      "investor_wedge": "Primary wedge type: REGULATION | SOVEREIGNTY | EU_INDUSTRIAL | DEFENSE | DISTRIBUTION | MARGIN",
      "tam_segment_eur": "Enterprise contribution to industry TAM estimate"
    }
  },
