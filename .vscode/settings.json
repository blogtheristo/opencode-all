{
  "files.associations": {
    "DWS_BRAND_STANDARD.md": "markdown",
    "DWS_DOCUMENT_STANDARD.md": "markdown",
    "UI_SKILLS_GAMMA.md": "markdown"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true
  },
  "terminal.integrated.profiles.windows": {
    "DWS6 Env (pwsh)": {
      "path": "pwsh",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Open-EnvTerminal.ps1",
        "-ReuseCurrentWindow"
      ],
      "overrideName": true
    }
  },
  "terminal.integrated.defaultProfile.windows": "DWS6 Env (pwsh)"
}
