{
  "files.associations": {
    "DWS_BRAND_STANDARD.md": "markdown",
    "DWS_DOCUMENT_STANDARD.md": "markdown",
    "UI_SKILLS_GAMMA.md": "markdown"
  },
  "search.exclude": {
    "**/.claude": true,
    "**/Learn": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true
  },
  "files.exclude": {
    "**/.claude": true,
    "**/Learn": true
  },
  "terminal.integrated.profiles.windows": {
    "DWS6 Env (pwsh)": {
      "path": "pwsh",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Open-EnvTerminal.ps1",
        "-ReuseCurrentWindow"
      ],
      "overrideName": true
    }
  },
  "terminal.integrated.defaultProfile.windows": "DWS6 Env (pwsh)",
  "htmlhint.options": {
    "inline-style-disabled": false
  },
  "python.terminal.activateEnvironment": true,
  "python.terminal.useEnvFile": true,
  "opencode.connector": "local-dgx-spark",
  "opencode.platform_strategy": {
    "primary": "opencode",
    "fallback": "claude-code",
    "handoff_file": ".claude/handoffs/<branch>.md",
    "description": "OpenCode + DGX Spark is primary runtime; Claude Code is hot standby for failover."
  },
  "opencode.dgx_configuration": {
    "hostname": "localhost",
    "port": 8080,
    "health_check_url": "/v1/health",
    "health_check_interval": 30,
    "auto_failover_on_health_check_fail": false,
    "description": "DGX Spark is primary. Health checks are automatic; platform switching is manual per DGX_DEPLOYMENT.md."
  },
  "opencode.mcp_servers": {
    "enabled": ["dws-gateway-local", "dws-agents-local"],
    "shared_with_claude_code": ["github", "google-drive", "figma", "supabase"]
  }
}
