{
  "files.associations": {
    "DWS_BRAND_STANDARD.md": "markdown",
    "DWS_DOCUMENT_STANDARD.md": "markdown",
    "UI_SKILLS_GAMMA.md": "markdown"
  },
  "search.exclude": {
    "**/.claude": true,
    "**/Learn": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true
  },
  "files.exclude": {
    "**/.claude": true,
    "**/Learn": true
  },
  "terminal.integrated.profiles.windows": {
    "DWS6 Env (pwsh)": {
      "path": "pwsh",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Open-EnvTerminal.ps1",
        "-ReuseCurrentWindow"
      ],
      "overrideName": true
    }
  },
  "terminal.integrated.defaultProfile.windows": "DWS6 Env (pwsh)",
  "htmlhint.options": {
    "inline-style-disabled": false
  },
  "python.terminal.activateEnvironment": true,
  "python.terminal.useEnvFile": true
}
